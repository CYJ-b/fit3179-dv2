{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Flow map of international visitor arrivals to Australia from the 22 largest origin countries. Line width is the number of arrivals in the selected year and line colour is that year as a percentage of the same country's 2019 arrivals. A year slider moves between 2019 and 2025.",
  "title": {
    "text": "How Did The Number of Visitors Change Over Time?",
    "subtitle": "Overseas arrivals to Australia by country of residence. Drag the slider to change the year (starts on 2021, the low point)."
  },
  "width": 900,
  "height": 420,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "year_selected",
      "value": 2021,
      "bind": {
        "input": "range",
        "min": 2019,
        "max": 2025,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34",
      "gridColor": "#E3DED3",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "padding": 4
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "labelFontWeight": 600
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 12,
      "color": "#1E2B34"
    },
    "concat": {
      "spacing": 24
    },
    "facet": {
      "spacing": 24
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#DCE9F2"
      }
    },
    {
      "data": {
        "url": "data/used/map_data/world_map_graticules_15.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_15"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#B8C7D3",
        "strokeWidth": 0.5,
        "opacity": 0.5
      }
    },
    {
      "data": {
        "url": "data/used/map_data/world_map_countries.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.NAME != 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#E9E4D8",
        "stroke": "#FBF8F2",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/used/flow_curves.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "arrivals": "number",
            "pct_of_2019": "number",
            "seq": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == year_selected"
        },
        {
          "calculate": "datum.pct_of_2019 < 10 ? 'a' : datum.pct_of_2019 < 50 ? 'b' : datum.pct_of_2019 < 90 ? 'c' : datum.pct_of_2019 < 100 ? 'd' : datum.pct_of_2019 < 120 ? 'e' : 'f'",
          "as": "pct_class"
        }
      ],
      "mark": {
        "type": "line",
        "strokeCap": "round",
        "strokeJoin": "round",
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "pct_class",
          "type": "ordinal",
          "title": "Arrivals as % of 2019",
          "sort": ["a", "b", "c", "d", "e", "f"],
          "scale": {
            "domain": ["a", "b", "c", "d", "e", "f"],
            "range": ["#4A1F08", "#9A4A14", "#C97F2E", "#E8C27A", "#8460BA", "#43257A"]
          },
          "legend": {
            "orient": "none",
            "legendX": 745,
            "legendY": 278,
            "direction": "vertical",
            "symbolType": "stroke",
            "symbolStrokeWidth": 4,
            "symbolSize": 400,
            "rowPadding": 3,
            "labelExpr": "({a: 'Under 10%', b: '10% to 50%', c: '50% to 90%', d: '90% to 100%', e: '100% to 120%', f: '120% or more'})[datum.value]"
          }
        },
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "order": {
          "field": "seq",
          "type": "quantitative"
        },
        "strokeWidth": {
          "field": "arrivals",
          "type": "quantitative",
          "title": "Number of Arrivals",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              1450000
            ],
            "range": [
              0.8,
              11
            ]
          },
          "legend": {
            "values": [
              10000,
              100000,
              500000,
              1000000
            ],
            "labelExpr": "format(datum.value, ',')",
            "symbolType": "stroke",
            "symbolSize": 400,
            "orient": "none",
            "legendX": 6,
            "legendY": 292,
            "direction": "vertical",
            "rowPadding": 3,
            "symbolStrokeColor": "#5B6770"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "arrivals",
            "type": "quantitative",
            "title": "Arrivals",
            "format": ","
          },
          {
            "field": "pct_of_2019",
            "type": "quantitative",
            "title": "% of 2019 arrivals",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/used/flow_arrivals.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "arrivals": "number",
            "lon": "number",
            "lat": "number",
            "dest_lon": "number",
            "dest_lat": "number",
            "pct_of_2019": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == year_selected"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 55,
        "stroke": "white",
        "strokeWidth": 1,
        "color": "#5B6770"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "arrivals",
            "type": "quantitative",
            "title": "Arrivals",
            "format": ","
          },
          {
            "field": "pct_of_2019",
            "type": "quantitative",
            "title": "% of 2019 arrivals",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/used/flow_arrivals.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == 2021"
        },
        {
          "filter": "indexof([\"China\", \"Japan\", \"South Korea\", \"India\", \"New Zealand\", \"United States of America\", \"Canada\", \"South Africa\", \"United Kingdom\", \"Ireland\", \"France\", \"Germany\"], datum.country) >= 0"
        },
        {
          "calculate": "datum.country == 'United States of America' ? 'USA' : datum.country",
          "as": "short"
        },
        {
          "calculate": "({\"China\": -9, \"Japan\": 9, \"South Korea\": 0, \"India\": -8, \"New Zealand\": 9, \"USA\": 9, \"Canada\": 9, \"South Africa\": 0, \"United Kingdom\": 0, \"Ireland\": -8, \"France\": -14, \"Germany\": 8})[datum.short]",
          "as": "lab_dx"
        },
        {
          "calculate": "({\"China\": -2, \"Japan\": -2, \"South Korea\": -12, \"India\": 10, \"New Zealand\": 2, \"USA\": -2, \"Canada\": -2, \"South Africa\": -11, \"United Kingdom\": -11, \"Ireland\": -2, \"France\": 0, \"Germany\": -8})[datum.short]",
          "as": "lab_dy"
        },
        {
          "calculate": "({\"China\": \"right\", \"Japan\": \"left\", \"South Korea\": \"center\", \"India\": \"right\", \"New Zealand\": \"left\", \"USA\": \"left\", \"Canada\": \"left\", \"South Africa\": \"center\", \"United Kingdom\": \"center\", \"Ireland\": \"right\", \"France\": \"right\", \"Germany\": \"left\"})[datum.short]",
          "as": "lab_align"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1E2B34",
        "baseline": "middle",
        "dx": {
          "expr": "datum.lab_dx"
        },
        "dy": {
          "expr": "datum.lab_dy"
        },
        "align": {
          "expr": "datum.lab_align"
        }
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "short",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/used/flow_arrivals.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "arrivals": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == year_selected"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "arrivals",
              "as": "total"
            }
          ]
        },
        {
          "calculate": "105",
          "as": "lon"
        },
        {
          "calculate": "-45",
          "as": "lat"
        },
        {
          "calculate": "'Total number of arrivals in ' + year_selected + ' is ' + format(datum.total, ',')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#1E2B34",
        "align": "center",
        "baseline": "top",
        "dy": 6
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
