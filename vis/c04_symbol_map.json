{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Proportional symbol map of international visitors to each of Australia's 76 tourism regions. Circle area is the number of visitors in the selected year and circle colour shows whether the region is coastal (blue) or inland (sand). A year slider moves between 2019 and 2025, a dropdown centres the map on a state or all of Australia, a zoom slider zooms in or out, and a checkbox hides regions outside the chosen state.",
  "title": {
    "text": "Number Of Visitors For Each Tourism Region",
    "subtitle": [
      "* Hover over a circle for details.",
      "* Use the Year, Zoom Centre and Zoom controls to look closer."
    ]
    },
  "width": 960,
  "height": 450,
  "projection": {
    "type": "albers",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ],
    "center": {
      "expr": "({AUS: [0, -27.5], NSW: [15.3, -33], VIC: [13.5, -36.7], QLD: [13.5, -20], SA: [3, -32], WA: [-11, -25], TAS: [14.5, -42.1], NT: [1.5, -18.5]})[state_view]"
    },
    "scale": {
      "expr": "({AUS: 740, NSW: 1900, VIC: 4000, QLD: 1150, SA: 1900, WA: 1000, TAS: 4000, NT: 1400})[state_view] * zoom_level"
    },
    "translate": [
      489.6,
      240
    ]
  },
  "params": [
    {
      "name": "state_view",
      "value": "AUS",
      "bind": {
        "input": "select",
        "options": [
          "AUS",
          "NSW",
          "VIC",
          "QLD",
          "SA",
          "WA",
          "TAS",
          "NT"
        ],
        "labels": [
          "Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory"
        ],
        "name": "Zoom Centre: "
      }
    },
    {
      "name": "zoom_level",
      "value": 0.9,
      "bind": {
        "input": "range",
        "min": 0.5,
        "max": 3,
        "step": 0.1,
        "name": "Zoom: "
      }
    },
    {
      "name": "state_filter",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Show For Selected Centre Only: "
      }
    },
    {
      "name": "year_selected",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2019,
        "max": 2025,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 26,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFontSize": 18,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "padding": 4
    },
    "text": {
      "fontSize": 12,
      "color": "#1E2B34"
    }
  },
  "data": {
    "url": "data/used/region_visits.csv",
    "format": {
      "type": "csv",
      "parse": {
        "centre_lon": "number",
        "centre_lat": "number",
        "year": "number",
        "visitors": "number",
        "pct_of_2019": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year == year_selected"
    },
    {
      "filter": "!state_filter || state_view == 'AUS' || datum.state == state_view || (state_view == 'NSW' && datum.state == 'ACT')"
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/used/map_data/states_map.json",
        "format": {
          "type": "topojson",
          "feature": "geoBoundaries-AUS-ADM1_simplified"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.shapeName != 'Other Territories'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#E9E4D8",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 122,
            "lat": -26,
            "t": "WESTERN AUSTRALIA"
          },
          {
            "lon": 133.5,
            "lat": -19.8,
            "t": "NORTHERN TERRITORY"
          },
          {
            "lon": 143.4,
            "lat": -22.5,
            "t": "QUEENSLAND"
          },
          {
            "lon": 135.2,
            "lat": -30.2,
            "t": "SOUTH AUSTRALIA"
          },
          {
            "lon": 146.6,
            "lat": -31.6,
            "t": "NEW SOUTH WALES"
          },
          {
            "lon": 140.6,
            "lat": -39.6,
            "t": "VICTORIA"
          },
          {
            "lon": 146.6,
            "lat": -43.8,
            "t": "TASMANIA"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#9A9486",
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "indexof([\"Sydney\", \"Melbourne\", \"Brisbane\", \"Destination Perth\", \"Gold Coast\"], datum.TR_NAME) >= 0"
        },
        {
          "calculate": "datum.centre_lon + ({\"Sydney\": 5, \"Melbourne\": 4.5, \"Brisbane\": 5.3, \"Destination Perth\": -4.5, \"Gold Coast\": 5.3})[datum.TR_NAME]",
          "as": "l_lon"
        },
        {
          "calculate": "datum.centre_lat + ({\"Sydney\": -1, \"Melbourne\": -2.5, \"Brisbane\": 1.9, \"Destination Perth\": 0, \"Gold Coast\": -1.6})[datum.TR_NAME]",
          "as": "l_lat"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#1E2B34",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "centre_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "centre_lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "l_lon"
        },
        "latitude2": {
          "field": "l_lat"
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "indexof([\"Sydney\", \"Melbourne\", \"Brisbane\", \"Destination Perth\", \"Gold Coast\"], datum.TR_NAME) >= 0 ? 'Top 5' : 'Other'",
          "as": "rank_group"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#000000"
      },
      "encoding": {
        "longitude": {
          "field": "centre_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "centre_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "visitors",
          "type": "quantitative",
          "title": "Visitors in the year",
          "scale": {
            "type": "pow",
            "exponent": 0.8,
            "domain": [
              0,
              4200000
            ],
            "range": [
              0,
              1500
            ]
          },
          "legend": {
            "values": [
              100000,
              500000,
              1000000,
              3000000
            ],
            "orient": "none",
            "legendX": 100,
            "legendY": 300,
            "symbolFillColor": "#FFFFFF00",
            "symbolStrokeColor": "#1E2B34",
            "rowPadding": 6
          }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "title": "Region type",
          "scale": {
            "domain": [
              "coastal",
              "inland"
            ],
            "range": [
              "#0B5E8E",
              "#C99A3B"
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 100,
            "legendY": 90,
            "symbolOpacity": 0.9,
            "labelExpr": "datum.value == 'coastal' ? 'Coastal region' : 'Inland region'",
            "symbolSize": 150
          }
        },
        "opacity": {
          "field": "rank_group",
          "type": "nominal",
          "scale": {
            "domain": ["Top 5", "Other"],
            "range": [0.9, 0.7]
          },
          "legend": null
        },
        "strokeWidth": {
          "field": "rank_group",
          "type": "nominal",
          "scale": {
            "domain": ["Top 5", "Other"],
            "range": [1.5, 0.5]
          },
          "legend": null
        },
        "order": {
          "field": "visitors",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "TR_NAME",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Visitors",
            "format": ","
          },
          {
            "field": "pct_of_2019",
            "type": "quantitative",
            "title": "% of 2019 visitors",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "indexof([\"Sydney\", \"Melbourne\", \"Brisbane\", \"Destination Perth\", \"Gold Coast\"], datum.TR_NAME) >= 0"
        },
        {
          "calculate": "({\"Sydney\": \"Sydney\", \"Melbourne\": \"Melbourne\", \"Brisbane\": \"Brisbane\", \"Destination Perth\": \"Perth\", \"Gold Coast\": \"Gold Coast\"})[datum.TR_NAME] + ' ' + format(datum.visitors / 1000000, '.1f') + 'm'",
          "as": "label"
        },
        {
          "calculate": "datum.centre_lon + ({\"Sydney\": 5, \"Melbourne\": 4.5, \"Brisbane\": 5.3, \"Destination Perth\": -4.5, \"Gold Coast\": 5.3})[datum.TR_NAME]",
          "as": "l_lon"
        },
        {
          "calculate": "datum.centre_lat + ({\"Sydney\": -1, \"Melbourne\": -2.5, \"Brisbane\": 1.9, \"Destination Perth\": 0, \"Gold Coast\": -1.6})[datum.TR_NAME]",
          "as": "l_lat"
        },
        {
          "calculate": "({\"Sydney\": \"left\", \"Melbourne\": \"left\", \"Brisbane\": \"left\", \"Destination Perth\": \"right\", \"Gold Coast\": \"left\"})[datum.TR_NAME]",
          "as": "lab_align"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": 600,
        "dx": {
          "expr": "datum.lab_align == 'left' ? 4 : -4"
        },
        "align": {
          "expr": "datum.lab_align"
        }
      },
      "encoding": {
        "longitude": {
          "field": "l_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "l_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
