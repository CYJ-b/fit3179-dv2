{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Choropleth map of tourism businesses per square kilometre in each of Australia's 76 tourism regions in 2025, in seven classes. Hovering a region highlights it and shows its details.",
  "title": {
    "text": "Amount Of Tourism Businesses Across The Tourism Regions In 2025",
    "subtitle": "Darker means more businesses packed into each square kilometre. Hover over a region for details."
  },
  "width": 960,
  "height": 480,
  "projection": {
    "type": "albers",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -27.5
    ],
    "scale": 740,
    "translate": [
      489.6,
      240
    ]
  },
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34",
      "gridColor": "#E3DED3",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "padding": 4
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "labelFontWeight": 600
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 12,
      "color": "#1E2B34"
    },
    "concat": {
      "spacing": 24
    },
    "facet": {
      "spacing": 24
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/used/businesses_region_year_size.csv",
        "format": {
          "type": "csv",
          "parse": {
            "TR_CODE": "number",
            "area_km2": "number",
            "year": "number",
            "businesses": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.size_band == 'All businesses' && datum.year == 2025"
        },
        {
          "calculate": "datum.businesses / datum.area_km2",
          "as": "per_km2"
        },
        {
          "calculate": "toString(datum.TR_CODE)",
          "as": "code"
        },
        {
          "lookup": "code",
          "from": {
            "data": {
              "url": "data/used/map_data/tourism_regions_2026.json",
              "format": {
                "type": "topojson",
                "feature": "Tourism_Regions_2026"
              }
            },
            "key": "properties.TR_CODE"
          },
          "as": "geo"
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": [
              "TR_CODE"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF"
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "per_km2",
          "type": "quantitative",
          "title": "Businesses per km²",
          "scale": {
            "type": "threshold",
            "domain": [
              0.01,
              0.05,
              0.25,
              1,
              5,
              10
            ],
            "range": [
              "#deebf7",
              "#c6dbef",
              "#9ecae1",
              "#6baed6",
              "#4292c6",
              "#2171b5",
              "#08306b"
            ]
          },
          "legend": null
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 2.4
          },
          "value": 0.6
        },
        "stroke": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": "#1E2B34"
          },
          "value": "#FFFFFF"
        },
        "tooltip": [
          {
            "field": "TR_NAME",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "businesses",
            "type": "quantitative",
            "title": "Tourism businesses",
            "format": ","
          },
          {
            "field": "per_km2",
            "type": "quantitative",
            "title": "Businesses per km²",
            "format": ".3f"
          },
          {
            "field": "area_km2",
            "type": "quantitative",
            "title": "Area (km²)",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/used/map_data/states_map.json",
        "format": {
          "type": "topojson",
          "feature": "geoBoundaries-AUS-ADM1_simplified"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.shapeName != 'Other Territories'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#1E2B34",
        "strokeWidth": 0.9,
        "opacity": 0.55
      }
    },
    {
      "data": {
        "url": "data/used/businesses_region_year_size.csv",
        "format": {
          "type": "csv",
          "parse": {
            "TR_CODE": "number",
            "area_km2": "number",
            "year": "number",
            "businesses": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.size_band == 'All businesses' && datum.year == 2025"
        },
        {
          "filter": "indexof([\"Melbourne\", \"Adelaide\", \"Sydney\", \"Gold Coast\"], datum.TR_NAME) >= 0"
        },
        {
          "calculate": "({\"Melbourne\": 144.89, \"Adelaide\": 138.6, \"Sydney\": 150.99, \"Gold Coast\": 153.31})[datum.TR_NAME]",
          "as": "c_lon"
        },
        {
          "calculate": "({\"Melbourne\": -37.81, \"Adelaide\": -34.87, \"Sydney\": -33.68, \"Gold Coast\": -27.96})[datum.TR_NAME]",
          "as": "c_lat"
        },
        {
          "calculate": "({\"Melbourne\": 139.3, \"Adelaide\": 133.6, \"Sydney\": 155.6, \"Gold Coast\": 156.4})[datum.TR_NAME]",
          "as": "l_lon"
        },
        {
          "calculate": "({\"Melbourne\": -40.6, \"Adelaide\": -37.6, \"Sydney\": -35.9, \"Gold Coast\": -29.9})[datum.TR_NAME]",
          "as": "l_lat"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#1E2B34",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "c_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "c_lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "l_lon"
        },
        "latitude2": {
          "field": "l_lat"
        }
      }
    },
    {
      "data": {
        "url": "data/used/businesses_region_year_size.csv",
        "format": {
          "type": "csv",
          "parse": {
            "TR_CODE": "number",
            "area_km2": "number",
            "year": "number",
            "businesses": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.size_band == 'All businesses' && datum.year == 2025"
        },
        {
          "filter": "indexof([\"Melbourne\", \"Adelaide\", \"Sydney\", \"Gold Coast\"], datum.TR_NAME) >= 0"
        },
        {
          "calculate": "({\"Melbourne\": 139.3, \"Adelaide\": 133.6, \"Sydney\": 155.6, \"Gold Coast\": 156.4})[datum.TR_NAME]",
          "as": "l_lon"
        },
        {
          "calculate": "({\"Melbourne\": -40.6, \"Adelaide\": -37.6, \"Sydney\": -35.9, \"Gold Coast\": -29.9})[datum.TR_NAME]",
          "as": "l_lat"
        },
        {
          "calculate": "({\"Melbourne\": \"right\", \"Adelaide\": \"right\", \"Sydney\": \"left\", \"Gold Coast\": \"left\"})[datum.TR_NAME]",
          "as": "l_align"
        },
        {
          "calculate": "datum.TR_NAME + ' ' + format(datum.businesses / datum.area_km2, '.1f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1E2B34",
        "baseline": "middle",
        "dx": {
          "expr": "datum.l_align == 'left' ? 4 : -4"
        },
        "align": {
          "expr": "datum.l_align"
        }
      },
      "encoding": {
        "longitude": {
          "field": "l_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "l_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "i": 0,
            "v": 0.005,
            "label": "0.01 or less  (14)"
          },
          {
            "i": 1,
            "v": 0.03,
            "label": "0.01 to 0.05  (24)"
          },
          {
            "i": 2,
            "v": 0.15,
            "label": "0.05 to 0.25  (16)"
          },
          {
            "i": 3,
            "v": 0.6,
            "label": "0.25 to 1  (13)"
          },
          {
            "i": 4,
            "v": 3,
            "label": "1 to 5  (5)"
          },
          {
            "i": 5,
            "v": 7.5,
            "label": "5 to 10  (1)"
          },
          {
            "i": 6,
            "v": 15,
            "label": "More than 10  (3)"
          }
        ]
      },
      "mark": {
        "type": "square",
        "size": 300,
        "opacity": 1,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5,
        "x": 16,
        "y": {
          "expr": "112 + datum.i * 24"
        }
      },
      "encoding": {
        "color": {
          "field": "v",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "type": "threshold",
            "domain": [
              0.01,
              0.05,
              0.25,
              1,
              5,
              10
            ],
            "range": [
              "#deebf7",
              "#c6dbef",
              "#9ecae1",
              "#6baed6",
              "#4292c6",
              "#2171b5",
              "#08306b"
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "i": 0,
            "v": 0.005,
            "label": "0.01 or less  (14)"
          },
          {
            "i": 1,
            "v": 0.03,
            "label": "0.01 to 0.05  (24)"
          },
          {
            "i": 2,
            "v": 0.15,
            "label": "0.05 to 0.25  (16)"
          },
          {
            "i": 3,
            "v": 0.6,
            "label": "0.25 to 1  (13)"
          },
          {
            "i": 4,
            "v": 3,
            "label": "1 to 5  (5)"
          },
          {
            "i": 5,
            "v": 7.5,
            "label": "5 to 10  (1)"
          },
          {
            "i": 6,
            "v": 15,
            "label": "More than 10  (3)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#1E2B34",
        "x": 32,
        "y": {
          "expr": "112 + datum.i * 24"
        }
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Tourism businesses per km²"
          },
          {
            "t": "(number of regions in each class)"
          }
        ]
      },
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "r"
            }
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#1E2B34",
        "x": 6,
        "y": {
          "expr": "datum.r == 1 ? 62 : 80"
        },
        "fontWeight": {
          "expr": "datum.r == 1 ? 700 : 400"
        }
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 113.2,
            "lat": -8.7,
            "dy": 0,
            "t": "Coast: 0.118 businesses per km²"
          },
          {
            "lon": 113.2,
            "lat": -8.7,
            "dy": 17,
            "t": "Inland: 0.008 (the coast is 14× denser)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12.5,
        "color": "#1E2B34",
        "dy": {
          "expr": "datum.dy"
        }
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}
