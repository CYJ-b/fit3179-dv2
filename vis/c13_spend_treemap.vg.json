{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Treemap of what tourists spent in coastal regions in 2024-25, $182.7 billion in total. Rectangle area is the amount spent. Five coloured groups contain 18 products: getting around, food and drink, stay, shopping and fun, and other services.",
  "width": 680,
  "height": 420,
  "padding": {
    "left": 2,
    "right": 2,
    "top": 6,
    "bottom": 6
  },
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "title": {
    "text": [
      "Economic Contributions Breakdown By Tourism Industries"
    ],
    "subtitle": [
      "Area = money spent. Hover over a rectangle for details."
    ],
    "anchor": "start",
    "font": "Fraunces, Georgia, serif",
    "fontSize": 20,
    "fontWeight": 600,
    "color": "#1E2B34",
    "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#5B6770",
    "subtitlePadding": 4,
    "offset": 12
  },
  "config": {
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif"
    }
  },
  "data": [
    {
      "name": "tree",
      "url": "data/used/consumption_products_coastal_2024_25.csv",
      "format": {
        "type": "csv",
        "parse": {
          "size": "number"
        }
      },
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "size",
          "method": "squarify",
          "round": true,
          "ratio": 1.3,
          "sort": {
            "field": "size",
            "order": "descending"
          },
          "paddingInner": 3,
          "paddingOuter": 3,
          "paddingTop": 24,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        },
        {
          "type": "formula",
          "as": "lines",
          "expr": "({'Shopping and souvenirs': ['Shopping and', 'souvenirs'], 'Recreation, culture and sport': ['Recreation,', 'culture and', 'sport'], 'Travel agents and info centres': ['Travel agents', 'and info centres']})[datum.label] || [datum.label]"
        },
        {
          "type": "formula",
          "as": "nl",
          "expr": "length(datum.lines)"
        },
        {
          "type": "formula",
          "as": "maxlen",
          "expr": "max(length(datum.lines[0]), length(datum.lines[1] || ''), length(datum.lines[2] || ''))"
        }
      ]
    },
    {
      "name": "group_totals",
      "source": "leaves",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "group"
          ],
          "fields": [
            "size"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "grand",
      "source": "leaves",
      "transform": [
        {
          "type": "aggregate",
          "fields": [
            "size"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        },
        {
          "type": "lookup",
          "from": "group_totals",
          "key": "group",
          "fields": [
            "group"
          ],
          "values": [
            "total"
          ],
          "as": [
            "total"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "colour",
      "type": "ordinal",
      "domain": [
        "Getting around",
        "Food and drink",
        "Stay",
        "Shopping and fun",
        "Other services"
      ],
      "range": [
        "#0072B2",
        "#E69F00",
        "#009E73",
        "#CC79A7",
        "#7F8A91"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "encode": {
        "enter": {
          "tooltip": {
            "signal": "{'Group': datum.label, 'Spend': '$' + format(datum.total / 1000, '.1f') + ' billion', 'Share of coastal tourist spending': format(datum.total / data('grand')[0].total, '.0%')}"
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "colour",
            "field": "group"
          },
          "fillOpacity": {
            "value": 0.22
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 6"
          },
          "y": {
            "signal": "datum.y0 + 4"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "signal": "length(datum.label + '  $' + format(datum.total / 1000, '.1f') + 'bn (' + format(datum.total / data('grand')[0].total, '.0%') + ')') * 7.4 <= (datum.x1 - datum.x0 - 12) ? datum.label + '  $' + format(datum.total / 1000, '.1f') + 'bn (' + format(datum.total / data('grand')[0].total, '.0%') + ')' : (length(datum.label + '  $' + format(datum.total / 1000, '.1f') + 'bn') * 7.4 <= (datum.x1 - datum.x0 - 12) ? datum.label + '  $' + format(datum.total / 1000, '.1f') + 'bn' : (length(datum.label) * 7.4 <= (datum.x1 - datum.x0 - 12) ? datum.label : ''))"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#1E2B34"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "tooltip": {
            "signal": "datum.label == 'Holiday-home rent' ? {'Product': datum.label, 'Group': datum.group, 'Spend': '$' + format(datum.size / 1000, '.1f') + ' billion', 'Share of coastal tourist spending': format(datum.size / data('grand')[0].total, '.1%'), 'What it is': 'Includes the notional rent that owners of holiday homes pay themselves'} : {'Product': datum.label, 'Group': datum.group, 'Spend': '$' + format(datum.size / 1000, '.1f') + ' billion', 'Share of coastal tourist spending': format(datum.size / data('grand')[0].total, '.1%')}"
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "colour",
            "field": "group"
          },
          "stroke": {
            "value": "#FBF8F2"
          },
          "strokeWidth": {
            "value": 1.5
          }
        },
        "hover": {
          "stroke": {
            "value": "#1E2B34"
          },
          "strokeWidth": {
            "value": 2.5
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 7"
          },
          "y": {
            "signal": "datum.y0 + 7"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "signal": "(datum.maxlen * 6.8 <= (datum.x1 - datum.x0 - 12) && datum.y1 - datum.y0 > 34 + (datum.nl - 1) * 15) ? datum.lines : ''"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "signal": "datum.group == 'Food and drink' ? '#1E2B34' : '#FFFFFF'"
          },
          "lineHeight": {
            "value": 15
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 7"
          },
          "y": {
            "signal": "datum.y0 + 10 + datum.nl * 15"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "signal": "(datum.maxlen * 6.8 <= (datum.x1 - datum.x0 - 12) && datum.y1 - datum.y0 > 46 + (datum.nl - 1) * 15) ? '$' + format(datum.size / 1000, '.1f') + 'bn' : ''"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "signal": "datum.group == 'Food and drink' ? '#1E2B34' : '#FFFFFF'"
          }
        }
      }
    }
  ]
}
