{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dumbbell chart for each Australian state and territory. One dot shows visits to coastal regions in 2025 as a percentage of 2019 and the other shows the same for inland regions, joined by a line. In every state that has both, the coastal dot is further right, so coastal regions have recovered further.",
  "title": {
    "text": [
      "Recovery Of Coastal Regions VS Inland Regions"
    ],
    "subtitle": [
      "International visits in 2025 as a percentage of 2019, 100% = same as 2019."
    ]
  },
  "width": 520,
  "height": 300,
  "data": {
    "url": "data/used/region_visits.csv",
    "format": {
      "type": "csv",
      "parse": {
        "TR_CODE": "number",
        "coastal_ratio": "number",
        "area_km2": "number",
        "centre_lon": "number",
        "centre_lat": "number",
        "year": "number",
        "visitors": "number",
        "pct_of_2019": "number"
      }
    }
  },
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34",
      "gridColor": "#E3DED3",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "padding": 4
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "labelFontWeight": 600
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 12,
      "color": "#1E2B34"
    },
    "concat": {
      "spacing": 24
    },
    "facet": {
      "spacing": 24
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "x": 100,
            "t": "100% = same as 2019"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#1E2B34",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2019 || datum.year == 2025"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "visitors",
              "as": "v"
            }
          ],
          "groupby": [
            "state",
            "category",
            "year"
          ]
        },
        {
          "pivot": "year",
          "value": "v",
          "groupby": [
            "state",
            "category"
          ]
        },
        {
          "calculate": "datum['2025'] / datum['2019'] * 100",
          "as": "pct"
        },
        {
          "pivot": "category",
          "value": "pct",
          "groupby": [
            "state"
          ]
        },
        {
          "calculate": "isValid(datum.coastal) && isValid(datum.inland) ? datum.coastal - datum.inland : -999",
          "as": "gap"
        },
        {
          "calculate": "({\"NSW\": \"New South Wales\", \"VIC\": \"Victoria\", \"QLD\": \"Queensland\", \"SA\": \"South Australia\", \"WA\": \"Western Australia\", \"NT\": \"Northern Territory\", \"TAS\": \"Tasmania\", \"ACT\": \"Australian Capital Territory\"})[datum.state]",
          "as": "state_name"
        },
        {
          "filter": "datum.gap > -999"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#8A9399",
        "strokeWidth": 3,
        "strokeCap": "round"
      },
      "encoding": {
        "y": {
          "field": "state_name",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "gap",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 13,
            "labelColor": "#1E2B34",
            "domain": false,
            "ticks": false,
            "labelLimit": 400
          }
        },
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              120
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "format": "d",
            "grid": true,
            "title": "Visits in 2025 as a percentage of 2019 visits"
          },
          "field": "inland"
        },
        "x2": {
          "field": "coastal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2019 || datum.year == 2025"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "visitors",
              "as": "v"
            }
          ],
          "groupby": [
            "state",
            "category",
            "year"
          ]
        },
        {
          "pivot": "year",
          "value": "v",
          "groupby": [
            "state",
            "category"
          ]
        },
        {
          "calculate": "datum['2025'] / datum['2019'] * 100",
          "as": "pct"
        },
        {
          "pivot": "category",
          "value": "pct",
          "groupby": [
            "state"
          ]
        },
        {
          "calculate": "isValid(datum.coastal) && isValid(datum.inland) ? datum.coastal - datum.inland : -999",
          "as": "gap"
        },
        {
          "calculate": "({\"NSW\": \"New South Wales\", \"VIC\": \"Victoria\", \"QLD\": \"Queensland\", \"SA\": \"South Australia\", \"WA\": \"Western Australia\", \"NT\": \"Northern Territory\", \"TAS\": \"Tasmania\", \"ACT\": \"Australian Capital Territory\"})[datum.state]",
          "as": "state_name"
        },
        {
          "fold": [
            "coastal",
            "inland"
          ],
          "as": [
            "category",
            "pct"
          ]
        },
        {
          "filter": "isValid(datum.pct)"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 230,
        "opacity": 1,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "state_name",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "gap",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 13,
            "labelColor": "#1E2B34",
            "domain": false,
            "ticks": false,
            "labelLimit": 400
          }
        },
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              120
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "format": "d",
            "grid": true,
            "title": "Visits in 2025 as a percentage of 2019 visits"
          },
          "field": "pct"
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "title": "Region type",
          "scale": {
            "domain": [
              "coastal",
              "inland"
            ],
            "range": [
              "#0B5E8E",
              "#C99A3B"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "titleAnchor": "start",
            "labelExpr": "datum.value == 'coastal' ? 'Coastal regions' : 'Inland regions'",
            "symbolSize": 160
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Region type"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "2025 visits as % of 2019",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2019 || datum.year == 2025"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "visitors",
              "as": "v"
            }
          ],
          "groupby": [
            "state",
            "category",
            "year"
          ]
        },
        {
          "pivot": "year",
          "value": "v",
          "groupby": [
            "state",
            "category"
          ]
        },
        {
          "calculate": "datum['2025'] / datum['2019'] * 100",
          "as": "pct"
        },
        {
          "pivot": "category",
          "value": "pct",
          "groupby": [
            "state"
          ]
        },
        {
          "calculate": "isValid(datum.coastal) && isValid(datum.inland) ? datum.coastal - datum.inland : -999",
          "as": "gap"
        },
        {
          "calculate": "({\"NSW\": \"New South Wales\", \"VIC\": \"Victoria\", \"QLD\": \"Queensland\", \"SA\": \"South Australia\", \"WA\": \"Western Australia\", \"NT\": \"Northern Territory\", \"TAS\": \"Tasmania\", \"ACT\": \"Australian Capital Territory\"})[datum.state]",
          "as": "state_name"
        },
        {
          "fold": [
            "coastal",
            "inland"
          ],
          "as": [
            "category",
            "pct"
          ]
        },
        {
          "filter": "isValid(datum.pct)"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1E2B34",
        "baseline": {
          "expr": "datum.state == 'WA' && datum.category == 'coastal' ? 'bottom' : 'middle'"
        },
        "align": {
          "expr": "datum.state == 'WA' && datum.category == 'coastal' ? 'center' : datum.category == 'inland' ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.state == 'WA' && datum.category == 'coastal' ? 0 : datum.category == 'inland' ? -11 : 11"
        },
        "dy": {
          "expr": "datum.state == 'WA' && datum.category == 'coastal' ? -11 : 0"
        }
      },
      "encoding": {
        "y": {
          "field": "state_name",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "gap",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 13,
            "labelColor": "#1E2B34",
            "domain": false,
            "ticks": false,
            "labelLimit": 400
          }
        },
        "x": {
          "field": "pct",
          "type": "quantitative"
        },
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2019 || datum.year == 2025"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "visitors",
              "as": "v"
            }
          ],
          "groupby": [
            "state",
            "category",
            "year"
          ]
        },
        {
          "pivot": "year",
          "value": "v",
          "groupby": [
            "state",
            "category"
          ]
        },
        {
          "calculate": "datum['2025'] / datum['2019'] * 100",
          "as": "pct"
        },
        {
          "pivot": "category",
          "value": "pct",
          "groupby": [
            "state"
          ]
        },
        {
          "calculate": "isValid(datum.coastal) && isValid(datum.inland) ? datum.coastal - datum.inland : -999",
          "as": "gap"
        },
        {
          "calculate": "({\"NSW\": \"New South Wales\", \"VIC\": \"Victoria\", \"QLD\": \"Queensland\", \"SA\": \"South Australia\", \"WA\": \"Western Australia\", \"NT\": \"Northern Territory\", \"TAS\": \"Tasmania\", \"ACT\": \"Australian Capital Territory\"})[datum.state]",
          "as": "state_name"
        },
        {
          "filter": "datum.gap == -999"
        },
        {
          "calculate": "datum.state == 'TAS' ? 'No inland regions' : 'No coastal region'",
          "as": "note"
        },
        {
          "calculate": "isValid(datum.coastal) ? datum.coastal : datum.inland",
          "as": "anchor"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": {
          "expr": "datum.state == 'TAS' ? -12 : -34"
        },
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#5B6770",
        "baseline": "middle"
      },
      "encoding": {
        "y": {
          "field": "state_name",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "gap",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 13,
            "labelColor": "#1E2B34",
            "domain": false,
            "ticks": false,
            "labelLimit": 400
          }
        },
        "x": {
          "field": "anchor",
          "type": "quantitative"
        },
        "text": {
          "field": "note",
          "type": "nominal"
        }
      }
    }
  ]
}
