{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dumbbell chart for each Australian state and territory. One dot shows visitors to coastal regions in 2025 as a percentage of 2019 and the other shows the same for inland regions, joined by a line. In every state that has both, the coastal dot is further right, so coastal regions have recovered further.",
  "title": {
    "text": [
      "Recovery Of Coastal Regions VS Inland Regions"
    ],
    "subtitle": [
      "International visitors in 2025 as a percentage of 2019.",
      "100% = same as 2019.",
      "* Hover over a dot for details."
    ]
  },
  "width": 520,
  "height": 300,
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 26,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFontSize": 18,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34",
      "gridColor": "#E3DED3",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "padding": 4
    },
    "text": {
      "fontSize": 12,
      "color": "#1E2B34"
    }
  },
  "data": {
    "url": "data/used/region_visits.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "visitors": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year == 2019 || datum.year == 2025"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "visitors",
          "as": "v"
        }
      ],
      "groupby": [
        "state",
        "category",
        "year"
      ]
    },
    {
      "pivot": "year",
      "value": "v",
      "groupby": [
        "state",
        "category"
      ]
    },
    {
      "calculate": "datum['2025'] / datum['2019'] * 100",
      "as": "pct"
    },
    {
      "pivot": "category",
      "value": "pct",
      "groupby": [
        "state"
      ]
    },
    {
      "calculate": "isValid(datum.coastal) && isValid(datum.inland) ? datum.coastal - datum.inland : -999",
      "as": "gap"
    },
    {
      "calculate": "({\"NSW\": \"New South Wales\", \"VIC\": \"Victoria\", \"QLD\": \"Queensland\", \"SA\": \"South Australia\", \"WA\": \"Western Australia\", \"NT\": \"Northern Territory\", \"TAS\": \"Tasmania\", \"ACT\": \"Australian Capital Territory\"})[datum.state]",
      "as": "state_name"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "x": 100
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#1E2B34",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.gap > -999"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#8A9399",
        "strokeWidth": 3,
        "strokeCap": "round"
      },
      "encoding": {
        "y": {
          "field": "state_name",
          "type": "nominal",
          "title": "State / territory",
          "sort": {
            "field": "gap",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 13,
            "labelColor": "#1E2B34",
            "domain": false,
            "ticks": false,
            "labelLimit": 400
          }
        },
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              120
            ]
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "format": "d",
            "title": "Visitors in 2025 as a percentage of 2019 visitors"
          },
          "field": "inland"
        },
        "x2": {
          "field": "coastal"
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "coastal",
            "inland"
          ],
          "as": [
            "category",
            "pct"
          ]
        },
        {
          "filter": "isValid(datum.pct)"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 230,
            "opacity": 1,
            "stroke": "#FFFFFF",
            "strokeWidth": 1.5
          },
          "encoding": {
            "y": {
              "field": "state_name",
              "type": "nominal",
              "sort": {
                "field": "gap",
                "op": "max",
                "order": "descending"
              }
            },
            "x": {
              "type": "quantitative",
              "axis": {
                "format": "d"
              },
              "field": "pct"
            },
            "color": {
              "field": "category",
              "type": "nominal",
              "title": "Region type",
              "scale": {
                "domain": [
                  "coastal",
                  "inland"
                ],
                "range": [
                  "#0B5E8E",
                  "#C99A3B"
                ]
              },
              "legend": {
                "orient": "top",
                "labelExpr": "datum.value == 'coastal' ? 'Coastal regions' : 'Inland regions'",
                "symbolSize": 200
              }
            },
            "tooltip": [
              {
                "field": "state_name",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "category",
                "type": "nominal",
                "title": "Region type"
              },
              {
                "field": "pct",
                "type": "quantitative",
                "title": "2025 visitors as % of 2019",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontWeight": 600,
            "baseline": {
              "expr": "datum.state == 'WA' && datum.category == 'coastal' ? 'bottom' : 'middle'"
            },
            "align": {
              "expr": "datum.state == 'WA' && datum.category == 'coastal' ? 'center' : datum.category == 'inland' ? 'right' : 'left'"
            },
            "dx": {
              "expr": "datum.state == 'WA' && datum.category == 'coastal' ? 0 : datum.category == 'inland' ? -11 : 11"
            },
            "dy": {
              "expr": "datum.state == 'WA' && datum.category == 'coastal' ? -11 : 0"
            }
          },
          "encoding": {
            "y": {
              "field": "state_name",
              "type": "nominal",
              "sort": {
                "op": "max",
                "order": "descending"
              }
            },
            "x": {
              "field": "pct",
              "type": "quantitative"
            },
            "text": {
              "field": "pct",
              "type": "quantitative",
              "format": ".0f"
            }
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.gap == -999"
        },
        {
          "calculate": "datum.state == 'TAS' ? 'No inland regions' : 'No coastal region'",
          "as": "note"
        },
        {
          "calculate": "isValid(datum.coastal) ? datum.coastal : datum.inland",
          "as": "anchor"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": {
          "expr": "datum.state == 'TAS' ? -12 : -34"
        },
        "fontStyle": "italic",
        "color": "#5B6770"
      },
      "encoding": {
        "y": {
          "field": "state_name",
          "type": "nominal",
          "sort": {
            "op": "max",
            "order": "descending"
          }
        },
        "x": {
          "field": "anchor",
          "type": "quantitative"
        },
        "text": {
          "field": "note",
          "type": "nominal"
        }
      }
    }
  ]
}
