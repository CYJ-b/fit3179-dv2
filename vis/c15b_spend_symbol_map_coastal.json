{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Proportional symbol map of tourism spend in Australia's 42 coastal tourism regions. Circle area is spend in 2024-25 (domestic and international tourists, $ million) and circle colour is spend in 2024-25 as an index of 2018-19 spend, in five classes. Inland regions are not shown. A State dropdown centres the map on a state or all of Australia, a Zoom slider zooms in or out, and a checkbox hides regions outside the chosen state.",
  "title": {
    "text": [
      "Coastal Region Spend in 2024-2025"
    ],
    "subtitle": "Coastal regions only. Hover over a circle for details. Use the State and Zoom controls to look closer."
  },
  "width": 960,
  "height": 480,
  "projection": {
    "type": "albers",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ],
    "center": {
      "expr": "({AUS: [0, -27.5], NSW: [15.3, -33], VIC: [13.5, -36.7], QLD: [13.5, -20], SA: [3, -32], WA: [-11, -25], TAS: [14.5, -42.1], NT: [1.5, -18.5]})[state_view]"
    },
    "scale": {
      "expr": "({AUS: 740, NSW: 1900, VIC: 4000, QLD: 1150, SA: 1900, WA: 1000, TAS: 4000, NT: 1400})[state_view] * zoom_level"
    },
    "translate": [
      489.6,
      240
    ]
  },
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34",
      "gridColor": "#E3DED3",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "padding": 4
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "labelFontWeight": 600
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 12,
      "color": "#1E2B34"
    },
    "concat": {
      "spacing": 24
    },
    "facet": {
      "spacing": 24
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/used/map_data/tourism_regions_2026.json",
        "format": {
          "type": "topojson",
          "feature": "Tourism_Regions_2026"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.TR_CODE != ''"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#E9E4D8",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 122.0,
            "lat": -26.0,
            "t": "WESTERN AUSTRALIA"
          },
          {
            "lon": 133.5,
            "lat": -19.8,
            "t": "NORTHERN TERRITORY"
          },
          {
            "lon": 143.4,
            "lat": -22.5,
            "t": "QUEENSLAND"
          },
          {
            "lon": 135.2,
            "lat": -30.2,
            "t": "SOUTH AUSTRALIA"
          },
          {
            "lon": 146.6,
            "lat": -31.6,
            "t": "NEW SOUTH WALES"
          },
          {
            "lon": 140.6,
            "lat": -39.6,
            "t": "VICTORIA"
          },
          {
            "lon": 146.6,
            "lat": -43.8,
            "t": "TASMANIA"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#9A9486",
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/used/tsa_spend_two_years.csv",
        "format": {
          "type": "csv",
          "parse": {
            "TR_CODE": "number",
            "consumption_m": "number",
            "centre_lon": "number",
            "centre_lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.category == 'coastal'"
        },
        {
          "filter": "datum.financial_year == '2018-19' || datum.financial_year == '2024-25'"
        },
        {
          "pivot": "financial_year",
          "value": "consumption_m",
          "groupby": [
            "TR_CODE",
            "TR_NAME",
            "state",
            "category",
            "centre_lon",
            "centre_lat"
          ]
        },
        {
          "calculate": "datum['2018-19']",
          "as": "spend_1819"
        },
        {
          "calculate": "datum['2024-25']",
          "as": "spend_2425"
        },
        {
          "calculate": "datum['2024-25'] / datum['2018-19'] * 100",
          "as": "spend_idx"
        },
        {
          "filter": "!state_filter || state_view == 'AUS' || datum.state == state_view || (state_view == 'NSW' && datum.state == 'ACT')"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.72,
        "strokeWidth": 0.6,
        "stroke": "#000000"
      },
      "encoding": {
        "longitude": {
          "field": "centre_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "centre_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "spend_2425",
          "type": "quantitative",
          "title": [
            "Tourism spend 2024-25",
            "($ million)"
          ],
          "scale": {
            "type": "linear",
            "domain": [
              0,
              40000
            ],
            "range": [
              0,
              3400
            ],
            "zero": true
          },
          "legend": {
            "values": [
              1000,
              5000,
              20000
            ],
            "labelExpr": "format(datum.value, ',')",
            "orient": "none",
            "legendX": 6,
            "legendY": 290,
            "symbolFillColor": "#FFFFFF00",
            "symbolStrokeColor": "#1E2B34",
            "rowPadding": 6
          }
        },
        "color": {
          "field": "spend_idx",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "type": "threshold",
            "domain": [
              80,
              100,
              120,
              150
            ],
            "range": [
              "#7A1A45",
              "#D98BA3",
              "#C9D77A",
              "#7F9A22",
              "#3F5210"
            ]
          }
        },
        "order": {
          "field": "spend_2425",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "TR_NAME",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "spend_2425",
            "type": "quantitative",
            "title": "Spend 2024-25 ($m)",
            "format": ",.0f"
          },
          {
            "field": "spend_1819",
            "type": "quantitative",
            "title": "Spend 2018-19 ($m)",
            "format": ",.0f"
          },
          {
            "field": "spend_idx",
            "type": "quantitative",
            "title": "Index (2018-19 = 100)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/used/tsa_spend_two_years.csv",
        "format": {
          "type": "csv",
          "parse": {
            "TR_CODE": "number",
            "consumption_m": "number",
            "centre_lon": "number",
            "centre_lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.category == 'coastal'"
        },
        {
          "filter": "datum.financial_year == '2024-25'"
        },
        {
          "filter": "!state_filter || state_view == 'AUS' || datum.state == state_view || (state_view == 'NSW' && datum.state == 'ACT')"
        },
        {
          "filter": "indexof([\"Sydney\", \"Melbourne\", \"Brisbane\", \"Destination Perth\", \"Gold Coast\"], datum.TR_NAME) >= 0"
        },
        {
          "calculate": "datum.centre_lon + ({\"Sydney\": 5, \"Melbourne\": -3.8, \"Brisbane\": 5.3, \"Destination Perth\": -4.5, \"Gold Coast\": 5.3})[datum.TR_NAME]",
          "as": "l_lon"
        },
        {
          "calculate": "datum.centre_lat + ({\"Sydney\": -1, \"Melbourne\": -3, \"Brisbane\": 1.9, \"Destination Perth\": 0, \"Gold Coast\": -1.6})[datum.TR_NAME]",
          "as": "l_lat"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#1E2B34",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "centre_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "centre_lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "l_lon"
        },
        "latitude2": {
          "field": "l_lat"
        }
      }
    },
    {
      "data": {
        "url": "data/used/tsa_spend_two_years.csv",
        "format": {
          "type": "csv",
          "parse": {
            "TR_CODE": "number",
            "consumption_m": "number",
            "centre_lon": "number",
            "centre_lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.category == 'coastal'"
        },
        {
          "filter": "datum.financial_year == '2018-19' || datum.financial_year == '2024-25'"
        },
        {
          "pivot": "financial_year",
          "value": "consumption_m",
          "groupby": [
            "TR_CODE",
            "TR_NAME",
            "state",
            "category",
            "centre_lon",
            "centre_lat"
          ]
        },
        {
          "calculate": "datum['2018-19']",
          "as": "spend_1819"
        },
        {
          "calculate": "datum['2024-25']",
          "as": "spend_2425"
        },
        {
          "calculate": "datum['2024-25'] / datum['2018-19'] * 100",
          "as": "spend_idx"
        },
        {
          "filter": "!state_filter || state_view == 'AUS' || datum.state == state_view || (state_view == 'NSW' && datum.state == 'ACT')"
        },
        {
          "filter": "indexof([\"Sydney\", \"Melbourne\", \"Brisbane\", \"Destination Perth\", \"Gold Coast\"], datum.TR_NAME) >= 0"
        },
        {
          "calculate": "[({\"Sydney\": \"Sydney\", \"Melbourne\": \"Melbourne\", \"Brisbane\": \"Brisbane\", \"Destination Perth\": \"Perth\", \"Gold Coast\": \"Gold Coast\"})[datum.TR_NAME], '$' + format(datum.spend_2425 / 1000, '.1f') + 'bn, index ' + format(datum.spend_idx, '.0f')]",
          "as": "label"
        },
        {
          "calculate": "datum.centre_lon + ({\"Sydney\": 5, \"Melbourne\": -3.8, \"Brisbane\": 5.3, \"Destination Perth\": -4.5, \"Gold Coast\": 5.3})[datum.TR_NAME]",
          "as": "l_lon"
        },
        {
          "calculate": "datum.centre_lat + ({\"Sydney\": -1, \"Melbourne\": -3, \"Brisbane\": 1.9, \"Destination Perth\": 0, \"Gold Coast\": -1.6})[datum.TR_NAME]",
          "as": "l_lat"
        },
        {
          "calculate": "({\"Sydney\": \"left\", \"Melbourne\": \"right\", \"Brisbane\": \"left\", \"Destination Perth\": \"right\", \"Gold Coast\": \"left\"})[datum.TR_NAME]",
          "as": "lab_align"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1E2B34",
        "baseline": "middle",
        "lineHeight": 14,
        "dx": {
          "expr": "datum.lab_align == 'left' ? 4 : -4"
        },
        "align": {
          "expr": "datum.lab_align"
        }
      },
      "encoding": {
        "longitude": {
          "field": "l_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "l_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "i": 0,
            "v": 50,
            "label": "Under 80: much lower (6)"
          },
          {
            "i": 1,
            "v": 90,
            "label": "80 to 100: a little lower (6)"
          },
          {
            "i": 2,
            "v": 110,
            "label": "100 to 120: a little higher (10)"
          },
          {
            "i": 3,
            "v": 135,
            "label": "120 to 150: higher (10)"
          },
          {
            "i": 4,
            "v": 170,
            "label": "150 or more: much higher (10)"
          }
        ]
      },
      "mark": {
        "type": "circle",
        "size": 190,
        "opacity": 0.72,
        "stroke": "#000000",
        "strokeWidth": 0.6,
        "x": 16,
        "y": {
          "expr": "112 + datum.i * 24"
        }
      },
      "encoding": {
        "color": {
          "field": "v",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "type": "threshold",
            "domain": [
              80,
              100,
              120,
              150
            ],
            "range": [
              "#7A1A45",
              "#D98BA3",
              "#C9D77A",
              "#7F9A22",
              "#3F5210"
            ]
          }
        }
      }
    },
    {
      "data": {
        "url": "data/used/tsa_spend_two_years.csv",
        "format": {
          "type": "csv",
          "parse": {
            "TR_CODE": "number",
            "consumption_m": "number",
            "centre_lon": "number",
            "centre_lat": "number"
          }
        }
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#1E2B34",
        "x": 32,
        "y": {
          "expr": "112 + datum.i * 24"
        }
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.category == 'coastal'"
        },
        {
          "filter": "datum.financial_year == '2018-19' || datum.financial_year == '2024-25'"
        },
        {
          "pivot": "financial_year",
          "value": "consumption_m",
          "groupby": [
            "TR_CODE",
            "TR_NAME",
            "state",
            "category",
            "centre_lon",
            "centre_lat"
          ]
        },
        {
          "calculate": "datum['2018-19']",
          "as": "spend_1819"
        },
        {
          "calculate": "datum['2024-25']",
          "as": "spend_2425"
        },
        {
          "calculate": "datum['2024-25'] / datum['2018-19'] * 100",
          "as": "spend_idx"
        },
        {
          "filter": "!state_filter || state_view == 'AUS' || datum.state == state_view || (state_view == 'NSW' && datum.state == 'ACT')"
        },
        {
          "calculate": "datum.spend_idx < 80 ? 0 : datum.spend_idx < 100 ? 1 : datum.spend_idx < 120 ? 2 : datum.spend_idx < 150 ? 3 : 4",
          "as": "i"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "i"
          ]
        },
        {
          "impute": "n",
          "key": "i",
          "keyvals": [
            0,
            1,
            2,
            3,
            4
          ],
          "value": 0
        },
        {
          "calculate": "[\"Under 80: much lower\", \"80 to 100: a little lower\", \"100 to 120: a little higher\", \"120 to 150: higher\", \"150 or more: much higher\"][datum.i] + ' (' + datum.n + ')'",
          "as": "label"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "t": "Spend 2024-25 compared with 2018-19"
          },
          {
            "t": "(index, 2018-19 = 100)"
          }
        ]
      },
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "r"
            }
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#1E2B34",
        "x": 6,
        "y": {
          "expr": "datum.r == 1 ? 62 : 80"
        },
        "fontWeight": {
          "expr": "datum.r == 1 ? 700 : 400"
        }
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ],
  "params": [
    {
      "name": "state_view",
      "value": "AUS",
      "bind": {
        "input": "select",
        "options": [
          "AUS",
          "NSW",
          "VIC",
          "QLD",
          "SA",
          "WA",
          "TAS",
          "NT"
        ],
        "labels": [
          "Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory"
        ],
        "name": "State: "
      }
    },
    {
      "name": "zoom_level",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 0.5,
        "max": 3,
        "step": 0.1,
        "name": "Zoom: "
      }
    },
    {
      "name": "state_filter",
      "value": true,
      "bind": {
        "input": "checkbox",
        "name": "Selected state only: "
      }
    }
  ]
}
