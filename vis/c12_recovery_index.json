{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Three small line charts, for tourism spend, value added and filled jobs. Each line shows coastal or inland regions as an index where 2018-19 equals 100, from 2008-09 to 2024-25. All three fell in 2020-21, then the coastal line rose above the inland line, most clearly for spend and jobs.",
  "title": {
    "text": [
      "How Has Coastal Recovered, Compared to Inland?"
    ],
    "subtitle": [
      "Values are indexed to its own 2018-19 level."
    ]
  },
  "data": {
    "url": "data/used/tsa_region_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "TR_CODE": "number",
        "consumption_m": "number",
        "gva_total_m": "number",
        "jobs_total_k": "number"
      }
    }
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "consumption_m",
          "as": "spend"
        },
        {
          "op": "sum",
          "field": "gva_total_m",
          "as": "gva"
        },
        {
          "op": "sum",
          "field": "jobs_total_k",
          "as": "jobs"
        }
      ],
      "groupby": [
        "category",
        "financial_year"
      ]
    },
    {
      "fold": [
        "spend",
        "gva",
        "jobs"
      ],
      "as": [
        "measure",
        "value"
      ]
    },
    {
      "calculate": "datum.financial_year == '2018-19' ? datum.value : null",
      "as": "base_helper"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "base_helper",
          "as": "base"
        }
      ],
      "groupby": [
        "category",
        "measure"
      ]
    },
    {
      "calculate": "datum.value / datum.base * 100",
      "as": "index"
    },
    {
      "calculate": "({\"spend\": \"Tourism spend\", \"gva\": \"Value added (GVA)\", \"jobs\": \"Filled jobs\"})[datum.measure]",
      "as": "panel"
    }
  ],
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34",
      "gridColor": "#E3DED3",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "padding": 4
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "labelFontWeight": 600
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 12,
      "color": "#1E2B34"
    },
    "concat": {
      "spacing": 24
    },
    "facet": {
      "spacing": 24
    }
  },
  "facet": {
    "column": {
      "field": "panel",
      "type": "nominal",
      "title": null,
      "sort": [
        "Tourism spend",
        "Value added (GVA)",
        "Filled jobs"
      ],
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": 700,
        "labelOrient": "top",
        "labelPadding": 10
      }
    }
  },
  "spec": {
    "width": 185,
    "height": 240,
    "layer": [
      {
        "mark": {
          "type": "rule",
          "stroke": "#1E2B34",
          "strokeDash": [
            4,
            4
          ],
          "strokeWidth": 1
        },
        "encoding": {
          "y": {
            "datum": 100,
            "type": "quantitative",
            "scale": {
              "domain": [
                40,
                160
              ],
              "nice": false
            },
            "axis": {
              "values": [
                40,
                60,
                80,
                100,
                120,
                140,
                160
              ],
              "grid": true
            },
            "title": "Index (2018-19 = 100)"
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "strokeWidth": 3,
          "strokeCap": "round"
        },
        "encoding": {
          "x": {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year (July to June)",
            "scale": {
              "padding": 0.3
            },
            "axis": {
              "values": [
                "2008-09",
                "2010-11",
                "2012-13",
                "2014-15",
                "2016-17",
                "2018-19",
                "2020-21",
                "2022-23",
                "2024-25"
              ],
              "labelAngle": -40,
              "labelFontSize": 11,
              "labelPadding": 4,
              "grid": false
            }
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "title": "Index (2018-19 = 100)",
            "scale": {
              "domain": [
                40,
                160
              ],
              "nice": false
            },
            "axis": {
              "values": [
                40,
                60,
                80,
                100,
                120,
                140,
                160
              ],
              "grid": true
            }
          },
          "color": {
            "field": "category",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": [
                "coastal",
                "inland"
              ],
              "range": [
                "#0B5E8E",
                "#C99A3B"
              ]
            },
            "legend": {
              "orient": "top",
              "direction": "horizontal",
              "symbolType": "stroke",
              "symbolSize": 400,
              "symbolStrokeWidth": 4,
              "labelExpr": "datum.value == 'coastal' ? 'Coastal regions' : 'Inland regions'"
            }
          },
          "detail": {
            "field": "category",
            "type": "nominal"
          }
        }
      },
      {
        "params": [
          {
            "name": "hover",
            "select": {
              "type": "point",
              "on": "mouseover",
              "clear": "mouseout",
              "nearest": true,
              "fields": [
                "financial_year"
              ]
            }
          }
        ],
        "mark": {
          "type": "point",
          "opacity": 0,
          "size": 400
        },
        "encoding": {
          "x": {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year (July to June)",
            "scale": {
              "padding": 0.3
            },
            "axis": {
              "values": [
                "2008-09",
                "2010-11",
                "2012-13",
                "2014-15",
                "2016-17",
                "2018-19",
                "2020-21",
                "2022-23",
                "2024-25"
              ],
              "labelAngle": -40,
              "labelFontSize": 11,
              "labelPadding": 4,
              "grid": false
            }
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "title": "Index (2018-19 = 100)",
            "scale": {
              "domain": [
                40,
                160
              ],
              "nice": false
            },
            "axis": {
              "values": [
                40,
                60,
                80,
                100,
                120,
                140,
                160
              ],
              "grid": true
            }
          },
          "tooltip": [
            {
              "field": "panel",
              "type": "nominal",
              "title": "Measure"
            },
            {
              "field": "category",
              "type": "nominal",
              "title": "Region type"
            },
            {
              "field": "financial_year",
              "type": "nominal",
              "title": "Financial year"
            },
            {
              "field": "index",
              "type": "quantitative",
              "title": "Index (2018-19 = 100)",
              "format": ".0f"
            },
            {
              "field": "value",
              "type": "quantitative",
              "title": "Value",
              "format": ",.0f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "rule",
          "stroke": "#1E2B34",
          "strokeWidth": 1
        },
        "encoding": {
          "x": {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year (July to June)",
            "scale": {
              "padding": 0.3
            },
            "axis": {
              "values": [
                "2008-09",
                "2010-11",
                "2012-13",
                "2014-15",
                "2016-17",
                "2018-19",
                "2020-21",
                "2022-23",
                "2024-25"
              ],
              "labelAngle": -40,
              "labelFontSize": 11,
              "labelPadding": 4,
              "grid": false
            }
          },
          "opacity": {
            "condition": {
              "param": "hover",
              "empty": false,
              "value": 0.7
            },
            "value": 0
          }
        }
      },
      {
        "mark": {
          "type": "circle",
          "size": 70,
          "opacity": 1
        },
        "encoding": {
          "x": {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year (July to June)",
            "scale": {
              "padding": 0.3
            },
            "axis": {
              "values": [
                "2008-09",
                "2010-11",
                "2012-13",
                "2014-15",
                "2016-17",
                "2018-19",
                "2020-21",
                "2022-23",
                "2024-25"
              ],
              "labelAngle": -40,
              "labelFontSize": 11,
              "labelPadding": 4,
              "grid": false
            }
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "title": "Index (2018-19 = 100)",
            "scale": {
              "domain": [
                40,
                160
              ],
              "nice": false
            },
            "axis": {
              "values": [
                40,
                60,
                80,
                100,
                120,
                140,
                160
              ],
              "grid": true
            }
          },
          "color": {
            "field": "category",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": [
                "coastal",
                "inland"
              ],
              "range": [
                "#0B5E8E",
                "#C99A3B"
              ]
            },
            "legend": {
              "orient": "top",
              "direction": "horizontal",
              "symbolType": "stroke",
              "symbolSize": 400,
              "symbolStrokeWidth": 4,
              "labelExpr": "datum.value == 'coastal' ? 'Coastal regions' : 'Inland regions'"
            }
          },
          "opacity": {
            "condition": {
              "param": "hover",
              "empty": false,
              "value": 1
            },
            "value": 0
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.financial_year == '2020-21' || datum.financial_year == '2024-25'"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 12,
          "fontWeight": 700,
          "align": "center",
          "dy": {
            "expr": "datum.category == 'coastal' ? (datum.financial_year == '2020-21' ? 16 : -10) : (datum.financial_year == '2020-21' ? 4 : 16)"
          },
          "dx": {
            "expr": "datum.category == 'inland' && datum.financial_year == '2020-21' ? -14 : 0"
          }
        },
        "encoding": {
          "x": {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year (July to June)",
            "scale": {
              "padding": 0.3
            },
            "axis": {
              "values": [
                "2008-09",
                "2010-11",
                "2012-13",
                "2014-15",
                "2016-17",
                "2018-19",
                "2020-21",
                "2022-23",
                "2024-25"
              ],
              "labelAngle": -40,
              "labelFontSize": 11,
              "labelPadding": 4,
              "grid": false
            }
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "title": "Index (2018-19 = 100)",
            "scale": {
              "domain": [
                40,
                160
              ],
              "nice": false
            },
            "axis": {
              "values": [
                40,
                60,
                80,
                100,
                120,
                140,
                160
              ],
              "grid": true
            }
          },
          "color": {
            "field": "category",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": [
                "coastal",
                "inland"
              ],
              "range": [
                "#0B5E8E",
                "#C99A3B"
              ]
            },
            "legend": {
              "orient": "top",
              "direction": "horizontal",
              "symbolType": "stroke",
              "symbolSize": 400,
              "symbolStrokeWidth": 4,
              "labelExpr": "datum.value == 'coastal' ? 'Coastal regions' : 'Inland regions'"
            }
          },
          "text": {
            "field": "index",
            "type": "quantitative",
            "format": ".0f"
          }
        }
      }
    ]
  }
}
