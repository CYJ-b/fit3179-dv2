{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Streamgraph of international visits to coastal tourism regions by main reason for the trip, quarter by quarter from 2018 to the first quarter of 2026. Layers are holiday, visiting friends and relatives, business, education, and employment and other reasons.",
  "title": {
    "text": [
      "The Main Reasons For Visiting Coastal Regions",
      "Across Time"
    ],
    "subtitle": [
      "Thickness of a band is the number of visits.",
      "Hover to see further details."
    ]
    },
  "width": 880,
  "height": 380,
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "labelColor": "#5B6770",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#1E2B34",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "text": {
      "fontSize": 12,
      "color": "#1E2B34"
    }
  },
  "data": {
    "url": "data/used/main_reason_coastal_quarterly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "visitors": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.main_reason == 'Employment' || datum.main_reason == 'Other reason' ? 'Employment and other' : datum.main_reason",
      "as": "reason"
    },
    {
      "calculate": "datetime(datum.year, (toNumber(substring(datum.quarter, 1)) - 1) * 3, 1)",
      "as": "date"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "visitors",
          "as": "visits"
        }
      ],
      "groupby": [
        "date",
        "reason"
      ]
    },
    {
      "stack": "visits",
      "groupby": [
        "date"
      ],
      "offset": "center",
      "sort": [
        {
          "field": "reason",
          "order": "ascending"
        }
      ],
      "as": [
        "y0",
        "y1"
      ]
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "date": "2020-03-20",
            "date2": "2022-02-21"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#E3DED3",
        "opacity": 0.75
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Year",
          "axis": {
            "format": "%Y",
            "tickCount": "year",
            "grid": false,
            "labelExpr": "datum.value > time(datetime(2026, 6, 1)) ? '' : timeFormat(datum.value, '%Y')"
          }
        },
        "x2": {
          "field": "date2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2020-04-01",
            "pos": 3360000,
            "t": "Borders were closed from",
            "w": 600
          },
          {
            "date": "2020-04-01",
            "pos": 3060000,
            "t": "20 Mar 2020 to 21 Feb 2022",
            "w": 400
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontWeight": {
          "expr": "datum.w"
        }
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "axis": {
            "format": "%Y"
          }
        },
        "y": {
          "field": "pos",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4700000
            ],
            "nice": false
          }
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.95,
        "stroke": "#FBF8F2",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "axis": {
            "format": "%Y"
          },
          "scale": {
            "domain": [
              {
                "year": 2018,
                "month": "jan",
                "date": 1
              },
              {
                "year": 2027,
                "month": "may",
                "date": 1
              }
            ]
          }
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": {
            "title": "Visits per quarter (read band thickness)",
            "format": "~s",
            "values": [0, 1000000, 2000000, 3000000, 4000000],
            "grid": true,
            "gridColor": "#E3DED3",
            "gridDash": [2, 3]
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "reason",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Holiday",
              "Visiting friends and relatives",
              "Business",
              "Education",
              "Employment and other"
            ],
            "range": [
              "#56B4E9",
              "#D55E00",
              "#CC79A7",
              "#009E73",
              "#8C8C8C"
            ]
          }
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Quarter starting",
            "format": "%b %Y"
          },
          {
            "field": "reason",
            "type": "nominal",
            "title": "Main reason"
          },
          {
            "field": "visits",
            "type": "quantitative",
            "title": "Visits",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "time(datum.date) == time(datetime(2026, 0, 1))"
        },
        {
          "calculate": "(datum.y0 + datum.y1) / 2",
          "as": "mid"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "axis": {
            "format": "%Y"
          }
        },
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "reason",
          "type": "nominal"
        },
        "color": {
          "field": "reason",
          "type": "nominal"
        }
      }
    }
  ]
}
