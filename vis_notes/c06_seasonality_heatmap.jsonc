// c06 heatmap - layered rect + text
// top 20 regions: joinaggregate, window (dense_rank), filter
// cells: layer 1 (rect, colour = share)
// numbers in the cells: layer 2 (text)
// colour scale: scheme blues
// layers, bottom to top:
//   1. coloured cells (rect) (main layer)
//   2. numbers in the cells (text)
// main layers: 1 (the coloured cells). 2 only adds the numbers on top.
//
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Heatmap of seasonality. Each row is one of the 20 coastal tourism regions with the most international visits in 2025, ordered from north to south. Each column is a quarter of the year and each cell shows the share of the region's yearly visits that fall in that quarter, 2023 to 2025 combined.",
  "title": {
    "text": [
      "Seasonality For Number Of International Visits For The",
      "Top 20 Coastal Regions"
    ],
    "subtitle": [
      "Share of each region's yearly visits that",
      "fall in each quarter (2023–2025 combined).",
      "* Hover over a cell for details."
    ]
  },
  // chart size, padding is a bit of space around everything
  "width": 480,
  "height": 400,
  "padding": {
    "left": 5,
    "right": 10,
    "top": 5,
    "bottom": 5
  },
  // global styling
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 26,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFontSize": 18,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#1E2B34",
      "titleColor": "#1E2B34",
      "padding": 4
    },
    "text": {
      "fontSize": 12
    }
  },
  // one row per region, year and quarter
  "data": {
    "url": "data/used/region_quarterly_visits.csv",
    "format": {
      "type": "csv",
      "parse": {
        "TR_CODE": "number",
        "year": "number",
        "visitors": "number",
        "centre_lat": "number"
      }
    }
  },
  // pick the top 20 coastal regions, then work out each quarter's share of the region's yearly
  //   visits
  "transform": [
    // coastal only
    {
      "filter": "datum.category == 'coastal'"
    },
    // visits for 2025 only (0 otherwise), so I can total 2025 per region next
    {
      "calculate": "datum.year == 2025 ? datum.visitors : 0",
      "as": "v2025"
    },
    // joinaggregate is like aggregate but keeps every row and adds the group total to it (total2025
    //   for each region)
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "v2025",
          "as": "total2025"
        }
      ],
      "groupby": [
        "TR_CODE"
      ]
    },
    // window with dense_rank ranks the rows by total2025 (window = calculations across rows)
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "rank2025"
        }
      ],
      "sort": [
        {
          "field": "total2025",
          "order": "descending"
        }
      ]
    },
    // keep the top 20 and years from 2023
    {
      "filter": "datum.rank2025 <= 20 && datum.year >= 2023"
    },
    // aggregate: visits per region and quarter, and keep the latitude so I can sort north to south
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "visitors",
          "as": "visits"
        },
        {
          "op": "max",
          "field": "centre_lat",
          "as": "lat"
        }
      ],
      "groupby": [
        "TR_NAME",
        "quarter"
      ]
    },
    // joinaggregate again: total visits for each region
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "visits",
          "as": "total"
        }
      ],
      "groupby": [
        "TR_NAME"
      ]
    },
    // share = quarter visits / region total x 100
    {
      "calculate": "datum.visits / datum.total * 100",
      "as": "share"
    },
    // nicer quarter labels using an object lookup
    {
      "calculate": "({'Q1': 'Jan–Mar', 'Q2': 'Apr–Jun', 'Q3': 'Jul–Sep', 'Q4': 'Oct–Dec'})[datum.quarter]",
      "as": "qlabel"
    }
  ],
  // 1 coloured rectangles (the heatmap), 2 numbers on top
  "layer": [
    // layer 1: the coloured cells
    {
      // rect mark, one rectangle per x/y pair
      "mark": {
        "type": "rect",
        "stroke": "#FBF8F2",
        "strokeWidth": 1.5
      },
      "encoding": {
        // x = quarter (ordinal), sort with a list fixes the order, axis orient top puts the axis
        //   above
        "x": {
          "field": "qlabel",
          "type": "ordinal",
          "title": "Quarter (Australian summer is Dec–Feb)",
          "sort": [
            "Jan–Mar",
            "Apr–Jun",
            "Jul–Sep",
            "Oct–Dec"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelPadding": 6,
            "ticks": false,
            "domain": false
          }
        },
        // y = region, sorted by latitude so it goes north to south
        "y": {
          "field": "TR_NAME",
          "type": "nominal",
          "title": "Region",
          "sort": {
            "field": "lat",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelColor": "#1E2B34",
            "ticks": false,
            "domain": false,
            "labelLimit": 170
          }
        },
        // colour = share. scheme blues is a built in palette, domain fixes min/max, legend at the
        //   bottom
        "color": {
          "field": "share",
          "type": "quantitative",
          "title": "Share of visits (%)",
          "scale": {
            "scheme": "blues",
            "domain": [
              10,
              38
            ]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 300,
            "format": "d"
          }
        },
        // hover info for each cell
        "tooltip": [
          {
            "field": "TR_NAME",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "qlabel",
            "type": "nominal",
            "title": "Quarter"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of yearly visits (%)",
            "format": ".1f"
          },
          {
            "field": "visits",
            "type": "quantitative",
            "title": "Visits, 2023–2025",
            "format": ","
          }
        ]
      }
    },
    // layer 2: the numbers in the cells, same x/y as layer 1 so they sit in the right cell
    {
      "mark": {
        "type": "text"
      },
      "encoding": {
        "x": {
          "field": "qlabel",
          "type": "ordinal",
          "title": "Quarter (Australian summer is Dec–Feb)",
          "sort": [
            "Jan–Mar",
            "Apr–Jun",
            "Jul–Sep",
            "Oct–Dec"
          ]
        },
        "y": {
          "field": "TR_NAME",
          "type": "nominal",
          "sort": {
            "order": "descending"
          }
        },
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".0f"
        },
        // condition = if/else for an encoding. white text when share > 26 (dark cell), dark text
        //   otherwise
        "color": {
          "condition": {
            "test": "datum.share > 26",
            "value": "white"
          },
          "value": "#1E2B34"
        }
      }
    }
  ]
}
