// c12 recovery index - facet + layer + hover
// index (2018-19 = 100): joinaggregate (base) then calculate (index)
// three panels: column = panel
// hover line and dots: param hover (nearest financial_year) + opacity condition
// layers, bottom to top:
//   inside the facet spec:
//   1. dashed line at 100
//   2. lines (main layer)
//   3. invisible hover points
//   4. hover vertical line
//   5. hover dots
//   6. value labels for 2020-21 and 2024-25 (annotation)
// main layers: 2 (the lines). 1 is the reference line, 3 to 5 are for the hover, 6 is labels.
//
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Three small line charts, for tourism spend, value added and filled jobs. Each line shows coastal or inland regions as an index where 2018-19 equals 100, from 2008-09 to 2024-25. All three fell in 2020-21, then the coastal line rose above the inland line, most clearly for spend and jobs.",
  "title": {
    "text": [
      "How Has Coastal Recovered, Compared to Inland?"
    ],
    "subtitle": [
      "Values are indexed to 2018-19.",
      "* Hover over a line for details."
    ]
  },
  // one row per region type and financial year
  "data": {
    "url": "data/used/tsa_region_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "consumption_m": "number",
        "gva_total_m": "number",
        "jobs_total_k": "number"
      }
    }
  },
  // shared steps before the facet
  "transform": [
    // aggregate: sum spend, GVA and jobs for each category + year
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "consumption_m",
          "as": "spend"
        },
        {
          "op": "sum",
          "field": "gva_total_m",
          "as": "gva"
        },
        {
          "op": "sum",
          "field": "jobs_total_k",
          "as": "jobs"
        }
      ],
      "groupby": [
        "category",
        "financial_year"
      ]
    },
    // fold: the 3 measure columns become rows (measure, value), so one chart definition covers all
    //   three
    {
      "fold": [
        "spend",
        "gva",
        "jobs"
      ],
      "as": [
        "measure",
        "value"
      ]
    },
    // base_helper: the value only in 2018-19, null otherwise
    {
      "calculate": "datum.financial_year == '2018-19' ? datum.value : null",
      "as": "base_helper"
    },
    // joinaggregate max copies that 2018-19 value onto every row of the same category + measure
    //   (the base)
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "base_helper",
          "as": "base"
        }
      ],
      "groupby": [
        "category",
        "measure"
      ]
    },
    // index = value / base x 100
    {
      "calculate": "datum.value / datum.base * 100",
      "as": "index"
    },
    // panel = the panel title
    {
      "calculate": "({\"spend\": \"Tourism spend\", \"gva\": \"Value added (GVA)\", \"jobs\": \"Filled jobs\"})[datum.measure]",
      "as": "panel"
    }
  ],
  // global styling. facet spacing = gap between panels
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 26,
      "fontWeight": 600,
      "color": "#1E2B34",
      "subtitleFontSize": 18,
      "anchor": "start",
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34",
      "gridColor": "#E3DED3",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#1E2B34",
      "padding": 4
    },
    "header": {
      "labelColor": "#1E2B34"
    },
    "text": {
      "fontSize": 12
    },
    "facet": {
      "spacing": 24
    }
  },
  // one panel per measure (column). the spec below is repeated in each
  "facet": {
    "column": {
      "field": "panel",
      "type": "nominal",
      "title": null,
      "sort": [
        "Tourism spend",
        "Value added (GVA)",
        "Filled jobs"
      ],
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": 700
      }
    }
  },
  // the chart in each panel
  "spec": {
    "width": 185,
    "height": 240,
    // 1 dashed line at 100, 2 lines, 3 invisible hover points, 4 hover vertical line, 5 hover dots,
    //   6 value labels (2020-21 and 2024-25)
    "layer": [
      {
        // rule at y = 100 using datum (a constant, not a field) = reference line
        "mark": {
          "type": "rule",
          "stroke": "#1E2B34",
          "strokeDash": [
            4,
            4
          ],
          "strokeWidth": 1
        },
        "encoding": {
          "y": {
            "datum": 100,
            "type": "quantitative",
            "scale": {
              "domain": [
                40,
                160
              ]
            },
            "axis": {
              "values": [
                40,
                60,
                80,
                100,
                120,
                140,
                160
              ],
              "grid": true
            }
          }
        }
      },
      // layer 2: the lines. colour = coastal/inland, legend on top with symbolType stroke
      {
        "mark": {
          "type": "line",
          "strokeWidth": 3,
          "strokeCap": "round"
        },
        "encoding": {
          "x": {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year (July to June)",
            "scale": {
              "padding": 0.3
            },
            "axis": {
              "values": [
                "2008-09",
                "2010-11",
                "2012-13",
                "2014-15",
                "2016-17",
                "2018-19",
                "2020-21",
                "2022-23",
                "2024-25"
              ],
              "labelAngle": -40,
              "labelFontSize": 11,
              "labelPadding": 4
            }
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "title": "Index (2018-19 = 100)",
            "axis": {
              "values": [
                40,
                60,
                80,
                100,
                120,
                140,
                160
              ]
            }
          },
          "color": {
            "field": "category",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": [
                "coastal",
                "inland"
              ],
              "range": [
                "#0B5E8E",
                "#C99A3B"
              ]
            },
            "legend": {
              "orient": "top",
              "symbolType": "stroke",
              "symbolSize": 450,
              "symbolStrokeWidth": 4.5,
              "labelExpr": "datum.value == 'coastal' ? 'Coastal regions' : 'Inland regions'"
            }
          }
        }
      },
      // layer 3: invisible points with a big hit area (size 400). the hover param snaps to the
      //   nearest financial_year, and these also carry the tooltip
      {
        "params": [
          {
            "name": "hover",
            "select": {
              "type": "point",
              "on": "mouseover",
              "clear": "mouseout",
              "nearest": true,
              "fields": [
                "financial_year"
              ]
            }
          }
        ],
        "mark": {
          "type": "point",
          "opacity": 0,
          "size": 400
        },
        "encoding": {
          "x": {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year (July to June)"
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "title": "Index (2018-19 = 100)",
            "axis": {
              "values": [
                40,
                60,
                80,
                100,
                120,
                140,
                160
              ]
            }
          },
          // hover info
          "tooltip": [
            {
              "field": "panel",
              "type": "nominal",
              "title": "Measure"
            },
            {
              "field": "category",
              "type": "nominal",
              "title": "Region type"
            },
            {
              "field": "financial_year",
              "type": "nominal",
              "title": "Financial year"
            },
            {
              "field": "index",
              "type": "quantitative",
              "title": "Index (2018-19 = 100)",
              "format": ".0f"
            },
            {
              "field": "value",
              "type": "quantitative",
              "title": "Value",
              "format": ",.0f"
            }
          ]
        }
      },
      // layer 4: vertical line only shown for the hovered year (opacity condition on the hover
      //   param)
      {
        "mark": {
          "type": "rule",
          "stroke": "#1E2B34",
          "strokeWidth": 1
        },
        "encoding": {
          "x": {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year (July to June)"
          },
          "opacity": {
            "condition": {
              "param": "hover",
              "empty": false,
              "value": 0.7
            },
            "value": 0
          }
        }
      },
      // layer 5: dots on the lines, only shown on hover (opacity condition)
      {
        "mark": {
          "type": "circle",
          "size": 70
        },
        "encoding": {
          "x": {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year (July to June)"
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "title": "Index (2018-19 = 100)",
            "axis": {
              "values": [
                40,
                60,
                80,
                100,
                120,
                140,
                160
              ]
            }
          },
          "color": {
            "field": "category",
            "type": "nominal"
          },
          "opacity": {
            "condition": {
              "param": "hover",
              "empty": false,
              "value": 1
            },
            "value": 0
          }
        }
      },
      // layer 6: value labels for 2020-21 and 2024-25 only. dx/dy expressions nudge them so they
      //   don't overlap
      {
        "transform": [
          {
            "filter": "datum.financial_year == '2020-21' || datum.financial_year == '2024-25'"
          }
        ],
        "mark": {
          "type": "text",
          "fontWeight": 700,
          "dy": {
            "expr": "datum.category == 'coastal' ? (datum.financial_year == '2020-21' ? 16 : -10) : (datum.financial_year == '2020-21' ? 4 : 16)"
          },
          "dx": {
            "expr": "datum.category == 'inland' && datum.financial_year == '2020-21' ? -14 : 0"
          }
        },
        "encoding": {
          "x": {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year (July to June)"
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "title": "Index (2018-19 = 100)",
            "axis": {
              "values": [
                40,
                60,
                80,
                100,
                120,
                140,
                160
              ]
            }
          },
          "color": {
            "field": "category",
            "type": "nominal"
          },
          "text": {
            "field": "index",
            "type": "quantitative",
            "format": ".0f"
          }
        }
      }
    ]
  }
}
