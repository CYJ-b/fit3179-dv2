// c08 slope graph - facet + layer
// two panels: facet (column = panel) + spec
// lines and dots: inside spec, layer
// highlight colours: calculate 'hex' + colour scale null
// layers, bottom to top:
//   inside the facet spec:
//   1. lines (main layer)
//   2. dots (main layer)
//   3. labels at 2019 (annotation)
//   4. labels at 2025 (annotation)
// main layers: 1 and 2 (the lines and the dots). 3 and 4 are labels.
//
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Slope graph with two panels, coastal and inland regions. Each line shows how the share of international visits with one length of stay (1 to 7 nights, 8 to 14, 15 to 30, 31 or more) changed between 2019 and 2025.",
  "title": {
    "text": "Length Of Stay In 2019 VS 2025",
    "subtitle": [
      "For international visits.",
      "* Hover over a line or dot for details."
    ]
  },
  // one row per region type, year and length of stay
  "data": {
    "url": "data/used/length_of_stay_share.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "visitors": "number",
        "share_pct": "number"
      }
    }
  },
  // this runs before the facet splits the data into panels
  "transform": [
    // remove 'Transit'
    {
      "filter": "datum.length_of_stay != 'Transit'"
    },
    // key = category + length_of_stay, used for the lookups below
    {
      "calculate": "datum.category + '|' + datum.length_of_stay",
      "as": "key"
    },
    // hex = the colour of each line. grey for most, blue/sand only for '31 or more nights' (my
    //   highlight). used with scale null
    {
      "calculate": "({\"coastal|1-7 nights\": \"#B3B9BD\", \"coastal|8-14 nights\": \"#B3B9BD\", \"coastal|15-30 nights\": \"#B3B9BD\", \"coastal|31 or more nights\": \"#0B5E8E\", \"inland|1-7 nights\": \"#B3B9BD\", \"inland|8-14 nights\": \"#B3B9BD\", \"inland|15-30 nights\": \"#B3B9BD\", \"inland|31 or more nights\": \"#C99A3B\"})[datum.key]",
      "as": "hex"
    },
    {
      "calculate": "({\"1-7 nights\": \"1\\u20137 nights\", \"8-14 nights\": \"8\\u201314 nights\", \"15-30 nights\": \"15\\u201330 nights\", \"31 or more nights\": \"31 or more nights\"})[datum.length_of_stay]",
      "as": "band"
    },
    {
      "calculate": "datum.length_of_stay != '31 or more nights' ? '#1E2B34' : datum.category == 'coastal' ? '#0B5E8E' : '#C99A3B'",
      "as": "txt_hex"
    },
    {
      "calculate": "datum.category == 'coastal' ? 'Coastal regions' : 'Inland regions'",
      "as": "panel"
    },
    // panel = the panel title
    {
      "calculate": "({\"coastal|2019|8-14 nights\": -6, \"coastal|2019|31 or more nights\": 6, \"coastal|2025|8-14 nights\": 7, \"coastal|2025|31 or more nights\": -7, \"inland|2019|8-14 nights\": -6, \"inland|2019|15-30 nights\": 6, \"inland|2025|8-14 nights\": -4, \"inland|2025|15-30 nights\": 7})[datum.category + '|' + datum.year + '|' + datum.length_of_stay] || 0",
      "as": "nudge"
    },
    // percentage as text for the labels
    {
      "calculate": "format(datum.share_pct, '.0f') + '%'",
      "as": "pct_text"
    }
  ],
  // global styling. facet spacing = gap between the panels
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 26,
      "fontWeight": 600,
      "color": "#1E2B34",
      "subtitleFontSize": 18,
      "anchor": "start",
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34",
      "gridColor": "#E3DED3",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "header": {
      "labelColor": "#1E2B34"
    },
    "text": {
      "fontSize": 12,
      "color": "#1E2B34"
    },
    "facet": {
      "spacing": 24
    }
  },
  // splits the data by a field (panel) and draws one chart for each value. column puts them side by
  //   side, header styles the titles. (repeat is different, it copies the same chart for different
  //   fields)
  "facet": {
    "column": {
      "field": "panel",
      "type": "nominal",
      "title": null,
      "sort": [
        "Coastal regions",
        "Inland regions"
      ],
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": 700,
        "labelPadding": 12
      }
    }
  },
  // the chart that gets drawn in each panel
  "spec": {
    "width": 400,
    // 1 lines, 2 dots (tooltip), 3 labels at 2019, 4 labels at 2025
    "layer": [
      // layer 1: the lines
      {
        // line joining 2019 to 2025 for each length of stay
        "mark": {
          "type": "line",
          "strokeWidth": 3.5,
          "strokeCap": "round"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            // domain goes up to 2028.3 so there's room on the right for the 2025 labels
            "scale": {
              "domain": [
                2018,
                2028.3
              ]
            },
            "axis": {
              "values": [
                2019,
                2025
              ],
              "format": "d",
              "labelFontSize": 14,
              "labelFontWeight": 700,
              "labelPadding": 6,
              "grid": false,
              "orient": "top",
              "domain": false,
              "ticks": false
            }
          },
          "y": {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of the group's visits (%)",
            "axis": {
              "values": [
                0,
                20,
                40,
                60,
                80
              ],
              "format": "d"
            }
          },
          // scale null = don't use a colour scale, the field already has the hex colour in it
          "color": {
            "field": "hex",
            "type": "nominal",
            "scale": null
          },
          // detail = one line per length_of_stay
          "detail": {
            "field": "length_of_stay",
            "type": "nominal"
          }
        }
      },
      // layer 2: dots on both ends, and the tooltip
      {
        "mark": {
          "type": "circle",
          "size": 90,
          "opacity": 1
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "scale": {
              "domain": [
                2018,
                2028.3
              ]
            }
          },
          "y": {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of the group's visits (%)",
            "axis": {
              "format": "d"
            }
          },
          "color": {
            "field": "hex",
            "type": "nominal",
            "scale": null
          },
          // hover info for each dot
          "tooltip": [
            {
              "field": "panel",
              "type": "nominal",
              "title": "Regions"
            },
            {
              "field": "band",
              "type": "nominal",
              "title": "Length of stay"
            },
            {
              "field": "year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "share_pct",
              "type": "quantitative",
              "title": "Share of visits (%)",
              "format": ".1f"
            },
            {
              "field": "visitors",
              "type": "quantitative",
              "title": "Visits",
              "format": ","
            }
          ]
        }
      },
      // layer 3: labels at 2019 (filter), on the left (align right, dx -10). dy expression nudges
      //   some labels so they don't overlap
      {
        "transform": [
          {
            "filter": "datum.year == 2019"
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "dx": -10,
          "fontWeight": 600,
          "dy": {
            "expr": "datum.nudge"
          }
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "scale": {
              "domain": [
                2018,
                2028.3
              ]
            }
          },
          "y": {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of the group's visits (%)",
            "axis": {
              "format": "d"
            }
          },
          "text": {
            "field": "pct_text",
            "type": "nominal"
          },
          "color": {
            "field": "txt_hex",
            "type": "nominal",
            "scale": null
          }
        }
      },
      // layer 4: labels at 2025 on the right, percentage + band name
      {
        "transform": [
          {
            "filter": "datum.year == 2025"
          },
          {
            "calculate": "datum.pct_text + '  ' + datum.band",
            "as": "end_label"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 10,
          "fontWeight": 600,
          "dy": {
            "expr": "datum.nudge"
          }
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "scale": {
              "domain": [
                2018,
                2028.3
              ]
            }
          },
          "y": {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of the group's visits (%)",
            "axis": {
              "format": "d"
            }
          },
          "text": {
            "field": "end_label",
            "type": "nominal"
          },
          "color": {
            "field": "txt_hex",
            "type": "nominal",
            "scale": null
          }
        }
      }
    ]
  }
}
