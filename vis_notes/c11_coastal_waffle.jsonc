// c11 waffle - facet + layer, 6 panels
// 100 squares per panel: sequence(100) + flatten
// grid position: row = floor(n / 10), col = n % 10
// six panels: facet with columns 3
// two line panel titles: header labelExpr splitting on '|'
// layers, bottom to top:
//   inside the facet spec:
//   1. the 100 squares (main layer)
//   2. big percentage text (annotation)
// main layers: 1 (the squares). 2 is the percentage text.
//
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Six waffle charts, each a grid of 100 squares where one square is one percentage point. Blue squares are the coastal share and sand squares the inland share of: land area (35%), tourism businesses (88%), international visits (93%), tourism spend (87%), value added (87%) and jobs (86%).",
  "title": {
    "text": "Tourism Metrics Proportion: Coastal VS Inland",
    "subtitle": [
      "One square = 1 percentage point.",
      "Land is the combined area of the regions.",
      "* Hover over a square for details."
    ]
  },
  // one row per measure (6 rows): coastal and inland totals and the coastal %
  "data": {
    "url": "data/used/coastal_share.csv",
    "format": {
      "type": "csv",
      "parse": {
        "coastal": "number",
        "inland": "number",
        "coastal_pct": "number"
      }
    }
  },
  // turns each of the 6 rows into 100 rows (one per square)
  "transform": [
    // panel = the title text, the '|' is where the title breaks onto a new line
    {
      "calculate": "({\"Land area (km2)\": \"Land area|all 76 tourism regions\", \"Tourism businesses (2025)\": \"Tourism businesses, 2025|in tourism industries\", \"International visits (2025)\": \"International visits, 2025|overseas visitors only\", \"Tourism spend, $m (2024-25)\": \"Tourism spend, 2024-25|domestic + international\", \"Tourism value added, $m (2024-25)\": \"Tourism value added|(GVA), 2024-25|domestic + international\", \"Tourism jobs, '000 (2024-25)\": \"Tourism jobs, 2024-25|domestic + international\"})[datum.measure]",
      "as": "panel"
    },
    // n_coastal = number of blue squares (coastal % rounded)
    {
      "calculate": "round(datum.coastal_pct)",
      "as": "n_coastal"
    },
    {
      "calculate": "format(datum.coastal_pct, '.0f') + '%'",
      "as": "pct_label"
    },
    // sequence(100) makes the array [0..99]
    {
      "calculate": "sequence(100)",
      "as": "n"
    },
    // flatten turns that array into 100 separate rows
    {
      "flatten": [
        "n"
      ]
    },
    // row and col of square n in a 10 x 10 grid
    {
      "calculate": "floor(datum.n / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.n % 10",
      "as": "col"
    },
    // kind: the first n_coastal squares are Coastal, the rest Inland
    {
      "calculate": "datum.n < datum.n_coastal ? 'Coastal' : 'Inland'",
      "as": "kind"
    }
  ],
  // global styling
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 26,
      "fontWeight": 600,
      "color": "#1E2B34",
      "subtitleFontSize": 18,
      "anchor": "start",
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#1E2B34",
      "padding": 4
    },
    "header": {
      "labelColor": "#1E2B34"
    },
    "facet": {
      "spacing": 24
    }
  },
  // splits by panel, one small waffle per value. with just one field the panels wrap, and columns
  //   says how many per row. header labelExpr splits the title into lines
  "facet": {
    "field": "panel",
    "type": "nominal",
    "title": null,
    "sort": [
      "Land area|all 76 tourism regions",
      "Tourism businesses, 2025|in tourism industries",
      "International visits, 2025|overseas visitors only",
      "Tourism spend, 2024-25|domestic + international",
      "Tourism value added|(GVA), 2024-25|domestic + international",
      "Tourism jobs, 2024-25|domestic + international"
    ],
    "header": {
      "labelExpr": "split(datum.label, '|')",
      "labelFontSize": 14,
      "labelFontWeight": 700,
      "labelLineHeight": 17,
      "labelAnchor": "start"
    }
  },
  // 3 panels per row
  "columns": 3,
  "spacing": {
    "column": 40
  },
  // the chart drawn in each panel
  "spec": {
    "width": 195,
    "height": 150,
    // 1 squares, 2 percentage text
    "layer": [
      // layer 1: the 100 squares
      {
        // square mark, one per row (100 per panel)
        "mark": {
          "type": "square",
          "size": 170,
          "opacity": 1
        },
        "encoding": {
          // x = col, y = row. axis null hides the axes. y sort descending so row 0 is at the top
          "x": {
            "field": "col",
            "type": "ordinal",
            "axis": null
          },
          "y": {
            "field": "row",
            "type": "ordinal",
            "axis": null,
            "sort": "descending"
          },
          // colour by kind (Coastal / Inland)
          "color": {
            "field": "kind",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": [
                "Coastal",
                "Inland"
              ],
              "range": [
                "#0B5E8E",
                "#C99A3B"
              ]
            },
            "legend": {
              "orient": "bottom",
              "symbolSize": 240
            }
          },
          // hover info
          "tooltip": [
            {
              "field": "panel",
              "type": "nominal",
              "title": "Measure"
            },
            {
              "field": "coastal_pct",
              "type": "quantitative",
              "title": "Coastal share (%)",
              "format": ".1f"
            },
            {
              "field": "coastal",
              "type": "quantitative",
              "title": "Coastal total",
              "format": ","
            },
            {
              "field": "inland",
              "type": "quantitative",
              "title": "Inland total",
              "format": ","
            }
          ]
        }
      },
      // layer 2: the big percentage text. filter keeps one row per panel (n == 0), x/y are pixel
      //   positions above the grid
      {
        "transform": [
          {
            "filter": "datum.n == 0"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "bottom",
          "fontSize": 24,
          "fontWeight": 700,
          "color": "#0B5E8E",
          "x": 0,
          "y": -6
        },
        "encoding": {
          "text": {
            "field": "pct_label",
            "type": "nominal"
          }
        }
      }
    ]
  }
}
