// c16 butterfly chart - nested layers
// bars going left: calculate full_neg = -full_time_k
// two bar series: layer 1 (full-time) and layer 2 (part-time), inside a nested layer
// shared encodings: the encoding on the nested layer (y, colour, tooltip) is inherited by layers 1
//   and 2
// centre line: layer 3 (rule at datum 0)
// layers, bottom to top:
//   1. full-time bars (inside a nested layer) (main layer)
//   2. part-time bars (same nested layer) (main layer)
//   3. centre line at 0
//   4. part-time % text (annotation)
// main layers: 1 and 2 (the full-time and part-time bars). 3 is the centre line, 4 is the text.
//
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Butterfly bar chart of direct tourism jobs in Australia's coastal tourism regions in 2024-25, one row per industry. Full-time jobs extend left and part-time jobs extend right from a shared centre line, in thousand jobs. Rows are sorted by total jobs, and each row is labelled with its part-time share.",
  "title": {
    "text": [
      "Distribution Of Tourism Jobs In Coastal Regions",
      "In 2024-2025"
    ],
    "subtitle": [
      "Direct tourism jobs in coastal regions, by industry.",
      "* Hover over a bar for details."
    ]
  },
  "width": 520,
  "height": 360,
  // global styling
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 26,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFontSize": 18,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34",
      "gridColor": "#E3DED3",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#1E2B34",
      "padding": 4
    },
    "text": {
      "fontSize": 12,
      "color": "#1E2B34"
    }
  },
  // one row per industry and region type
  "data": {
    "url": "data/used/jobs_detail_2024_25.csv",
    "format": {
      "type": "csv",
      "parse": {
        "full_time_k": "number",
        "part_time_k": "number",
        "total_k": "number",
        "part_time_pct": "number"
      }
    }
  },
  // shared by all layers
  "transform": [
    // coastal only
    {
      "filter": "datum.category == 'coastal'"
    },
    // full_neg = full time jobs made negative so their bars go left of zero
    {
      "calculate": "-datum.full_time_k",
      "as": "full_neg"
    },
    // pt_label = text like '41% part-time' for the label
    {
      "calculate": "format(datum.part_time_pct, '.0f') + '% part-time'",
      "as": "pt_label"
    }
  ],
  // 1 full-time bars, 2 part-time bars (1 and 2 are in a nested layer), 3 centre line, 4 part-time
  //   % text
  "layer": [
    // layers 1 and 2: the two bar series (a nested layer)
    {
      // encoding on the parent layer is inherited by every child layer: y (industry, sorted by
      //   total), colour (series) and tooltip
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "total_k",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "title": "Industry",
            "labelLimit": 220,
            "labelColor": "#1E2B34",
            "domain": false,
            "ticks": false
          }
        },
        // colour comes from the 'series' field that each child layer makes ('Full-time' /
        //   'Part-time'), fixed colours
        "color": {
          "type": "nominal",
          "scale": {
            "domain": [
              "Full-time",
              "Part-time"
            ],
            "range": [
              "#C1272D",
              "#F2C705"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top"
          },
          "field": "series"
        },
        // hover info
        "tooltip": [
          {
            "field": "label",
            "type": "nominal",
            "title": "Industry"
          },
          {
            "field": "full_time_k",
            "type": "quantitative",
            "title": "Full-time (thousand jobs)",
            "format": ".1f"
          },
          {
            "field": "part_time_k",
            "type": "quantitative",
            "title": "Part-time (thousand jobs)",
            "format": ".1f"
          },
          {
            "field": "total_k",
            "type": "quantitative",
            "title": "Total (thousand jobs)",
            "format": ".1f"
          },
          {
            "field": "part_time_pct",
            "type": "quantitative",
            "title": "Part-time share (%)",
            "format": ".1f"
          }
        ]
      },
      // layer 1 = full-time, layer 2 = part-time, in the same rows
      "layer": [
        // layer 1: full-time bars (negative values, go left)
        {
          // this layer's rows get the label 'Full-time' (the colour encoding uses it)
          "transform": [
            {
              "calculate": "'Full-time'",
              "as": "series"
            }
          ],
          // bar with height {band: 0.72} = 72% of each row's height
          "mark": {
            "type": "bar",
            "height": {
              "band": 0.72
            },
            "stroke": "#1E2B34",
            "strokeWidth": 0.5
          },
          "encoding": {
            // x = negative full time jobs. labelExpr uses abs() so the axis labels on the left show
            //   positive numbers
            "x": {
              "field": "full_neg",
              "type": "quantitative",
              "scale": {
                "domain": [
                  -70,
                  170
                ],
                "nice": false
              },
              "axis": {
                "title": [
                  "Number of Jobs (in thousands)"
                ],
                "labelExpr": "format(abs(datum.value), ',')",
                "values": [
                  -40,
                  0,
                  40,
                  80,
                  120,
                  160
                ]
              }
            }
          }
        },
        // layer 2: part-time bars. x = part_time_k (positive so it goes right). y, colour and
        //   tooltip come from the parent
        {
          "transform": [
            {
              "calculate": "'Part-time'",
              "as": "series"
            }
          ],
          "mark": {
            "type": "bar",
            "height": {
              "band": 0.72
            },
            "stroke": "#1E2B34",
            "strokeWidth": 0.5
          },
          "encoding": {
            "x": {
              "field": "part_time_k",
              "type": "quantitative"
            }
          }
        }
      ]
    },
    // layer 3: centre line. datum 0 = a constant position (not a data field)
    {
      "mark": {
        "type": "rule",
        "stroke": "#1E2B34",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative"
        }
      }
    },
    // layer 4: text after each part-time bar (e.g. '41% part-time')
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "op": "max",
            "order": "descending"
          }
        },
        "x": {
          "field": "part_time_k",
          "type": "quantitative"
        },
        "text": {
          "field": "pt_label",
          "type": "nominal"
        }
      }
    }
  ]
}
