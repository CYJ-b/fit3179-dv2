// c07 streamgraph - layered, stack transform
// stream shape: stack with offset center (gives y0 and y1)
// the streams: layer 3 (area, y = y0, y2 = y1)
// grey border closure band: layer 1 (rect with x and x2)
// labels at the end: layer 4
// layers, bottom to top:
//   1. grey band for the border closure
//   2. 'Borders were closed...' text (annotation)
//   3. the streams (area) (main layer)
//   4. reason names at the end of the streams (annotation)
// main layers: 3 (the streams). 1 is the shaded closure band, 2 and 4 are annotations.
//
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Streamgraph of international visits to coastal tourism regions by main reason for the trip, quarter by quarter from 2018 to the first quarter of 2026. Layers are holiday, visiting friends and relatives, business, education, and employment and other reasons.",
  "title": {
    "text": [
      "The Main Reasons For Visiting Coastal Regions",
      "Across Time"
    ],
    "subtitle": [
      "Thickness of a band is the number of international visits.",
      "* Hover over a band for details."
    ]
    },
  "width": 880,
  "height": 380,
  // global styling
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 26,
      "fontWeight": 600,
      "color": "#1E2B34",
      "anchor": "start",
      "subtitleFontSize": 18,
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "labelColor": "#5B6770",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#1E2B34",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "text": {
      "fontSize": 12,
      "color": "#1E2B34"
    }
  },
  // one row per quarter per reason
  "data": {
    "url": "data/used/main_reason_coastal_quarterly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "visitors": "number"
      }
    }
  },
  // shared by all layers
  "transform": [
    // merge 'Employment' and 'Other reason' into one group
    {
      "calculate": "datum.main_reason == 'Employment' || datum.main_reason == 'Other reason' ? 'Employment and other' : datum.main_reason",
      "as": "reason"
    },
    // make a real date from year + quarter (Q1 = January, Q2 = April...)
    {
      "calculate": "datetime(datum.year, (toNumber(substring(datum.quarter, 1)) - 1) * 3, 1)",
      "as": "date"
    },
    // aggregate: total visits for each date + reason
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "visitors",
          "as": "visits"
        }
      ],
      "groupby": [
        "date",
        "reason"
      ]
    },
    // stack works out where each band starts and ends at every date. offset center centres the
    //   stack around the middle, which is what makes it a streamgraph (normally it'd be a stacked
    //   area). gives y0 (bottom) and y1 (top)
    {
      "stack": "visits",
      "groupby": [
        "date"
      ],
      "offset": "center",
      "sort": [
        {
          "field": "reason",
          "order": "ascending"
        }
      ],
      "as": [
        "y0",
        "y1"
      ]
    }
  ],
  // 1 grey band for the border closure, 2 annotation text, 3 the streams, 4 stream labels. the band
  //   is first so the streams are drawn over it
  "layer": [
    {
      "data": {
        // layer 1: grey band for the border closure. inline data, just the start and end date
        "values": [
          {
            "date": "2020-03-20",
            "date2": "2022-02-21"
          }
        ]
      },
      // rect with x and x2 = a shaded block between two dates
      "mark": {
        "type": "rect",
        "color": "#E3DED3",
        "opacity": 0.75
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Year",
          "axis": {
            "format": "%Y",
            "tickCount": "year",
            "grid": false,
            // hides the axis labels after mid 2026 (I extended the domain to fit the labels)
            "labelExpr": "datum.value > time(datetime(2026, 6, 1)) ? '' : timeFormat(datum.value, '%Y')"
          }
        },
        "x2": {
          "field": "date2"
        }
      }
    },
    // layer 2: annotation text from inline values, fontWeight is read from a field (w)
    {
      "data": {
        "values": [
          {
            "date": "2020-04-01",
            "pos": 3360000,
            "t": "Borders were closed from",
            "w": 600
          },
          {
            "date": "2020-04-01",
            "pos": 3060000,
            "t": "20 Mar 2020 to 21 Feb 2022",
            "w": 400
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontWeight": {
          "expr": "datum.w"
        }
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "axis": {
            "format": "%Y"
          }
        },
        "y": {
          "field": "pos",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4700000
            ],
            "nice": false
          }
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    // layer 3: the streams. area mark, interpolate monotone smooths the edges
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.95,
        "stroke": "#FBF8F2",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "axis": {
            "format": "%Y"
          },
          // x domain goes to 2027 so there's empty space on the right for the labels
          "scale": {
            "domain": [
              {
                "year": 2018,
                "month": "jan",
                "date": 1
              },
              {
                "year": 2027,
                "month": "may",
                "date": 1
              }
            ]
          }
        },
        // y = y0 and y2 = y1 (from the stack), so the area is drawn between the bottom and top of
        //   each band
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": {
            "title": "Visits per quarter (read band thickness)",
            "format": "~s",
            "values": [0, 1000000, 2000000, 3000000, 4000000],
            "grid": true,
            "gridColor": "#E3DED3",
            "gridDash": [2, 3]
          }
        },
        "y2": {
          "field": "y1"
        },
        // colour = reason, domain/range keeps each reason's colour fixed. legend null since I label
        //   the streams directly
        "color": {
          "field": "reason",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Holiday",
              "Visiting friends and relatives",
              "Business",
              "Education",
              "Employment and other"
            ],
            "range": [
              "#56B4E9",
              "#D55E00",
              "#CC79A7",
              "#009E73",
              "#8C8C8C"
            ]
          }
        },
        // hover info for each band
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Quarter starting",
            "format": "%b %Y"
          },
          {
            "field": "reason",
            "type": "nominal",
            "title": "Main reason"
          },
          {
            "field": "visits",
            "type": "quantitative",
            "title": "Visits",
            "format": ","
          }
        ]
      }
    },
    // layer 4: labels on the streams. filter keeps the Q1 2026 rows only, mid is the middle of the
    //   band so the text sits in the centre
    {
      "transform": [
        {
          "filter": "time(datum.date) == time(datetime(2026, 0, 1))"
        },
        {
          "calculate": "(datum.y0 + datum.y1) / 2",
          "as": "mid"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "axis": {
            "format": "%Y"
          }
        },
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "reason",
          "type": "nominal"
        },
        "color": {
          "field": "reason",
          "type": "nominal"
        }
      }
    }
  ]
}
