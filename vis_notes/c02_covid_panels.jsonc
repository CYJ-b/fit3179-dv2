// c02 covid panels - vconcat + layer
// two charts stacked: vconcat
// linked hover line: params hover_dth and hover_arr, the vertical rule in both panels reads both
// closure/reopen dates: named dataset 'events'
// layers, bottom to top:
//   top panel (deaths): 1. area (main layer), 2. dashed event lines, 3. event text (annotation), 4.
//   invisible hover points, 5. hover vertical line
//   bottom panel (arrivals): 6. area (main layer), 7. dashed event lines, 8. invisible hover
//   points, 9. hover vertical line
// main layers: the two area layers, 1 (deaths) and 6 (arrivals). the rest are event markers (2, 3,
//   7) and hover helpers (4, 5, 8, 9).
//
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Two aligned time-series panels from January 2018. The top panel shows monthly COVID-19 deaths reported to the WHO worldwide (January 2020 to June 2023); the bottom panel shows monthly overseas visitor arrivals to Australia. Dashed lines mark the border closure on 20 March 2020 and the reopening on 21 February 2022.",
  "title": {
    "text": "Number Of Arrivals And Deaths Reported Over Time",
    "subtitle": [
      "COVID-19 deaths reported to the WHO worldwide (top).", 
      "Monthly visitor arrivals to Australia (bottom).",
      "* Hover over either chart to compare any month."
    ]
  },
  // global styling. view stroke null removes the border around the plots
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 26,
      "fontWeight": 600,
      "color": "#1E2B34",
      "subtitleFontSize": 18,
      "anchor": "start",
      "subtitleColor": "#5B6770",
      "subtitlePadding": 4,
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5B6770",
      "titleColor": "#1E2B34",
      "gridColor": "#E3DED3",
      "domainColor": "#A8AEB3",
      "tickColor": "#A8AEB3"
    },
    "text": {
      "fontSize": 12,
      "color": "#1E2B34"
    }
  },
  // one row per month. the date: parse turns the text into real dates
  "data": {
    "url": "data/used/covid_monthly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "arrivals": "number",
        "who_new_cases": "number",
        "date": "date:'%Y-%m-%d'",
        "who_new_deaths": "number"
      }
    }
  },
  // named inline data, the layers use it with data: {name: 'events'}. keeps the two dates in one
  //   place
  "datasets": {
    "events": [
      {
        "d": "2020-03-20",
        "t": "20 Mar 2020: borders close"
      },
      {
        "d": "2022-02-21",
        "t": "21 Feb 2022: borders reopen"
      }
    ]
  },
  // vconcat puts the charts one above the other. each one has its own layers but they share the top
  //   level data and config. (hconcat is side by side)
  "vconcat": [
    {
      "width": 880,
      "height": 130,
      // top panel only: deaths in thousands (new field who_d)
      "transform": [
        {
          "calculate": "isValid(datum.who_new_deaths) ? datum.who_new_deaths / 1000 : null",
          "as": "who_d"
        }
      ],
      // top panel layers: 1 area, 2 dashed event lines, 3 event text, 4 invisible hover points, 5
      //   hover line
      "layer": [
        // layer 1 (top panel): area for the WHO deaths
        {
          // area mark, the line option also draws the outline on top
          "mark": {
            "type": "area",
            "color": "#6E6A66",
            "opacity": 0.65,
            "line": {
              "color": "#6E6A66",
              "strokeWidth": 1.2
            }
          },
          "encoding": {
            "x": {
              "field": "date",
              "type": "temporal",
              // fixed x domain so both panels line up
              "scale": {
                "domain": [
                  {
                    "year": 2018,
                    "month": "jan",
                    "date": 1
                  },
                  {
                    "year": 2026,
                    "month": "oct",
                    "date": 1
                  }
                ]
              },
              "title": null,
              "axis": {
                "labels": false,
                "ticks": false,
                "grid": false,
                "domain": false
              }
            },
            "y": {
              "field": "who_d",
              "type": "quantitative",
              "title": "WHO deaths (thousands)",
              "scale": {
                "domain": [
                  0,
                  600
                ]
              },
              "axis": {
                "tickCount": 5
              }
            }
          }
        },
        // layer 2: event lines. rule = a straight line, strokeDash makes it dashed
        {
          "data": {
            "name": "events"
          },
          "mark": {
            "type": "rule",
            "stroke": "#1E2B34",
            "strokeDash": [
              4,
              3
            ],
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "field": "d",
              "type": "temporal"
            }
          }
        },
        // layer 3: text for the events (annotation)
        {
          "data": {
            "name": "events"
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 5,
            "dy": 2
          },
          "encoding": {
            "x": {
              "field": "d",
              "type": "temporal"
            },
            "y": {
              "value": 0
            },
            "text": {
              "field": "t",
              "type": "nominal"
            }
          }
        },
        // layer 4: invisible points that catch the hover
        {
          // selection param. point on mouseover, clears on mouseout, nearest snaps to the closest
          //   point, fields date means it selects by month so the same month shows in both panels
          "params": [
            {
              "name": "hover_dth",
              "select": {
                "type": "point",
                "on": "mouseover",
                "clear": "mouseout",
                "nearest": true,
                "fields": [
                  "date"
                ]
              }
            }
          ],
          // invisible points (opacity 0), they are only here to catch the mouse and give the
          //   tooltip
          "mark": {
            "type": "point",
            "opacity": 0,
            "size": 200
          },
          "encoding": {
            "x": {
              "field": "date",
              "type": "temporal"
            },
            "y": {
              "field": "who_d",
              "type": "quantitative"
            },
            // same info in both panels
            "tooltip": [
              {
                "field": "date",
                "type": "temporal",
                "title": "Month",
                "format": "%b %Y"
              },
              {
                "field": "arrivals",
                "type": "quantitative",
                "title": "Visitor arrivals",
                "format": ","
              },
              {
                "field": "who_new_cases",
                "type": "quantitative",
                "title": "WHO reported new cases",
                "format": ","
              },
              {
                "field": "who_new_deaths",
                "type": "quantitative",
                "title": "WHO reported new deaths",
                "format": ","
              }
            ]
          }
        },
        // layer 5: the hover vertical line. opacity uses a condition, it shows (0.7) if hover_dth
        //   or hover_arr is active and is 0 otherwise. empty:false so nothing selected means hidden
        {
          "mark": {
            "type": "rule",
            "stroke": "#1E2B34",
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "field": "date",
              "type": "temporal"
            },
            "opacity": {
              "condition": [
                {
                  "param": "hover_dth",
                  "empty": false,
                  "value": 0.7
                },
                {
                  "param": "hover_arr",
                  "empty": false,
                  "value": 0.7
                }
              ],
              "value": 0
            }
          }
        }
      ]
    },
    // bottom panel (arrivals), layers 6 to 9: area, event lines, hover points, hover line. same as
    //   the top panel but no event text
    {
      "width": 880,
      "height": 170,
      "transform": [
        {
          "calculate": "datum.arrivals / 1000",
          "as": "arr_k"
        }
      ],
      // bottom panel layers: 6 area, 7 event lines, 8 invisible hover points, 9 hover line (same as
      //   the top panel, but no event text)
      "layer": [
        // layer 6 (bottom panel): area for the arrivals
        {
          "mark": {
            "type": "area",
            "color": "#1B998B",
            "opacity": 0.35,
            "line": {
              "color": "#1B998B",
              "strokeWidth": 1.8
            }
          },
          "encoding": {
            "x": {
              "field": "date",
              "type": "temporal",
              "scale": {
                "domain": [
                  {
                    "year": 2018
                  },
                  {
                    "year": 2026,
                    "month": "oct"
                  }
                ]
              },
              "title": "Year",
              "axis": {
                "format": "%Y",
                "tickCount": "year",
                "grid": false
              }
            },
            "y": {
              "field": "arr_k",
              "type": "quantitative",
              "title": "Arrivals (thousands)",
              "scale": {
                "domain": [
                  0,
                  1250
                ]
              },
              "axis": {
                "tickCount": 5
              }
            }
          }
        },
        // layer 7: dashed event lines (same as layer 2)
        {
          "data": {
            "name": "events"
          },
          "mark": {
            "type": "rule",
            "stroke": "#1E2B34",
            "strokeDash": [
              4,
              3
            ],
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "field": "d",
              "type": "temporal"
            }
          }
        },
        // layer 8: invisible hover points (same idea as layer 4)
        {
          // the second selection param, the top panel's line listens to this one as well
          "params": [
            {
              "name": "hover_arr",
              "select": {
                "type": "point",
                "on": "mouseover",
                "clear": "mouseout",
                "nearest": true,
                "fields": [
                  "date"
                ]
              }
            }
          ],
          "mark": {
            "type": "point",
            "opacity": 0,
            "size": 200
          },
          "encoding": {
            "x": {
              "field": "date",
              "type": "temporal"
            },
            "y": {
              "field": "arr_k",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "date",
                "type": "temporal",
                "title": "Month",
                "format": "%b %Y"
              },
              {
                "field": "arrivals",
                "type": "quantitative",
                "title": "Visitor arrivals",
                "format": ","
              },
              {
                "field": "who_new_cases",
                "type": "quantitative",
                "title": "WHO reported new cases",
                "format": ","
              },
              {
                "field": "who_new_deaths",
                "type": "quantitative",
                "title": "WHO reported new deaths",
                "format": ","
              }
            ]
          }
        },
        // layer 9: hover vertical line (same as layer 5)
        {
          "mark": {
            "type": "rule",
            "stroke": "#1E2B34",
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "field": "date",
              "type": "temporal"
            },
            "opacity": {
              "condition": [
                {
                  "param": "hover_dth",
                  "empty": false,
                  "value": 0.7
                },
                {
                  "param": "hover_arr",
                  "empty": false,
                  "value": 0.7
                }
              ],
              "value": 0
            }
          }
        }
      ]
    }
  ],
  // gap between the panels. bounds flush means each panel is sized without its axes/labels so they
  //   stay aligned
  "spacing": 40,
  "bounds": "flush"
}
